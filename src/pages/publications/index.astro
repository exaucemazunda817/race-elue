---
// Page non maquettée : reprend la section « Des mots pour t'accompagner » de l'accueil (README de passation).
import Base from '../../layouts/Base.astro';
import PubCards from '../../components/PubCards.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';
import PageHero from '../../components/PageHero.astro';
import { HERO } from '../../data/hero';
---
<Base
  title="Publications"
  description="L'ebook gratuit « Comment Dieu guérit les cœurs brisés » et le magazine de la foi « Devenu une légende », publiés par RED Éditions."
  active="/publications"
>
  <PageHero photos={HERO.publications} align="centre">
    <span class="kicker or">Publications · RED Éditions</span>
    <h1 class="h1">Des mots pour <em>t'accompagner</em></h1>
    <p class="lead">Un ebook pour avancer vers la guérison intérieure, un magazine pour nourrir ta foi. Tout est gratuit, à lire en ligne ou à télécharger.</p>
  </PageHero>
  <section class="wrap pubs">
    <PubCards />
    <div class="bientot">
      <span class="star" aria-hidden="true">✦</span>
      <div class="stack">
        <span class="kicker">Bientôt</span>
        <span class="titre">Prochaine parution</span>
        <span class="desc">Inscris-toi ci-dessous pour être prévenue le jour de sa sortie.</span>
      </div>
    </div>
  </section>
  <NewsletterBand flushTop={false} />
</Base>

<style>
  .head { padding-top: 36px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .lead { max-width: 620px; }
  .pubs { display: flex; flex-direction: column; gap: 16px; padding-top: 40px; padding-bottom: 8px; }
  .bientot { border-radius: var(--r-carte); box-shadow: inset 0 0 0 1.5px var(--bordure); padding: 24px; display: flex; gap: 20px; align-items: center; }
  .star { width: 64px; aspect-ratio: 3 / 4; border-radius: 3px; box-shadow: inset 0 0 0 1.5px var(--bordure); display: flex; align-items: center; justify-content: center; color: var(--sauge); font-size: 22px; flex: none; }
  .stack { gap: 6px; }
  .titre { font: 500 26px/1.05 var(--serif); color: var(--cacao); }
  .desc { font-size: 15px; color: var(--secondaire); }
  @media (min-width: 960px) {
    .head { padding-top: 96px; padding-bottom: 56px; align-items: center; text-align: center; gap: 22px; }
    .pubs { gap: 32px; padding-top: var(--sec-2); }
    .bientot { padding: 32px; }
  }
</style>
