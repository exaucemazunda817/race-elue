---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Photo from '../../../components/Photo.astro';
import Cover from '../../../components/Cover.astro';
import TestimonialCard from '../../../components/TestimonialCard.astro';
import SubscribeForm from '../../../components/SubscribeForm.astro';
import StickyBar from '../../../components/StickyBar.astro';
import { EBOOK, MAGAZINE, SITE } from '../../../data/site';
import { byIndex, hasExamples } from '../../../data/temoignages';

// Sommaire réel de l'ebook (page 2 du PDF)
const sommaire = [
  { num: '', titre: 'Salutations', page: '03', simple: true },
  { num: '', titre: 'Introduction', page: '04', simple: true },
  { num: '✦', titre: 'Reconnaître sa blessure pour laisser Dieu la guérir', page: '05' },
  { num: '1', titre: "Dieu guérit les personnes brisées à travers d'autres humains", page: '07' },
  { num: '2', titre: 'Dieu guérit par notre identité en lui', page: '09' },
  { num: '3', titre: 'Dieu guérit nos cœurs par la prière', page: '11' },
  { num: '4', titre: 'Dieu guérit avec le temps', page: '13' },
  { num: '5', titre: 'Dieu guérit par le présent', page: '15' },
  { num: '', titre: 'Conclusion', page: '17', simple: true },
];
const temoignages = byIndex(0, 3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: EBOOK.titre,
  author: { '@type': 'Person', name: SITE.nom },
  publisher: { '@type': 'Organization', name: SITE.editeur },
  bookFormat: 'https://schema.org/EBook',
  numberOfPages: EBOOK.pages,
  inLanguage: 'fr',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'CDF', availability: 'https://schema.org/InStock' },
};
---
<Base
  title={EBOOK.titre}
  description="Ebook gratuit de Race Élue Disanka : cinq pensées pour laisser Dieu guérir les blessures intérieures. Reçois-le par e-mail ou lis un extrait sans inscription."
  ogImage="/og/ebook.jpg"
  ogType="book"
  active="/publications"
  stickyBar
  jsonLd={jsonLd}
>
  <section class="hero bg-sable wrap">
    <nav class="crumb" aria-label="Fil d'Ariane">
      <a href="/publications" class="only-desktop">Publications</a>
      <Icon name="caret-right" size={14} class="only-desktop" />
      <span class="only-desktop" aria-current="page">{EBOOK.titre}</span>
      <a href="/publications" class="only-mobile back"><Icon name="arrow-left" size={18} />Publications</a>
    </nav>
    <div class="hero-grid">
      <div class="cover-wrap">
        <div class="cover-arche" aria-hidden="true"></div>
        <Cover kind="ebook" width={380} sizes="(min-width: 960px) 380px, 200px" priority shadow="lg" />
      </div>
      <div class="hero-txt">
        <span class="kicker"><span class="only-desktop">Ebook · Guide de guérison intérieure</span><span class="only-mobile">Ebook · gratuit</span></span>
        <h1 class="h1" style="--h1-d:68px;--h1-m:40px;--h1-vw:4.7vw">Comment Dieu guérit <em>les cœurs brisés</em></h1>
        <p class="lead only-desktop">Si Dieu nous aime tant, pourquoi permet-il que nous soyons blessées ? Et surtout, comment guérit-il ? En cinq pensées, je te partage ce que j'ai appris, avec douceur et sans jugement.</p>
        <p class="lead only-mobile">En cinq pensées, je te partage ce que j'ai appris sur la guérison intérieure, avec douceur et sans jugement.</p>
        <ul class="meta">
          <li><Icon name="book-open" size={20} />{EBOOK.pages} pages</li>
          <li><Icon name="file-pdf" size={20} />{EBOOK.poids}</li>
          <li><Icon name="clock" size={20} />{EBOOK.lecture}</li>
        </ul>
        <div class="get card" id="recevoir">
          <div class="get-head">
            <h2>Reçois-le gratuitement</h2>
            <span class="prix only-desktop">0 FC</span>
          </div>
          <SubscribeForm id="ebook" button="Recevoir l'ebook" source="ebook" after="merci" />
          <p class="small only-desktop">Tu le reçois dans ta boîte mail en quelques minutes, avec une pensée par semaine. Désinscription en un clic.</p>
        </div>
        <span class="small only-desktop">Publié par RED Éditions · 2025</span>
      </div>
    </div>
  </section>

  <section class="wrap sec sommaire">
    <div class="stack som-intro">
      <span class="kicker">Sommaire</span>
      <h2 class="h2" style="--h2-m:30px">Cinq pensées pour <em>laisser Dieu agir</em></h2>
      <p class="only-desktop">Chaque pensée se lit en quelques minutes et se termine par une prière. Tu peux les lire dans l'ordre, ou t'arrêter sur celle qui te parle aujourd'hui.</p>
    </div>
    <ol class="toc">
      {sommaire.map((s) => (
        <li class:list={{ simple: s.simple, etoile: s.num === '✦', chiffre: /\d/.test(s.num) }}>
          <span class="num" aria-hidden={s.num === '✦' ? 'true' : undefined}>{s.num}</span>
          <span class="titre">{s.titre}</span>
          <span class="page"><span class="sr-only">page </span>{s.page}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap sec bg-pale extrait">
    <div class="extrait-col">
      <span class="kicker vert"><span class="only-desktop">Extrait · Introduction</span><span class="only-mobile">Extrait</span></span>
      <div class="extrait-card">
        <p class="drop">Ce recueil porte sur une question majeure : comment Dieu guérit-il les cœurs brisés ? Autrement dit : comment Dieu guérit-il une personne blessée ? Mais pour savoir comment Dieu guérit les cœurs brisés, il importe d'abord de comprendre pourquoi il les guérit…</p>
        <div class="fade" aria-hidden="true"></div>
        <div class="extrait-actions">
          <a class="btn btn-outline" href={`/publications/${EBOOK.slug}/extrait`}>Lire l'extrait complet</a>
          <span class="small">3 pages, sans inscription</span>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap sec autrice only-desktop">
    <div class="autrice-photo">
      <Photo src="studio-smile.jpg" alt="Race Élue assise sur une chaise, souriante, devant un fond beige avec un cœur de lumière" position="center 40%" sizes="360px" />
    </div>
    <div class="stack autrice-txt">
      <span class="kicker">L'autrice</span>
      <h2 class="h2" style="--h2-d:44px">Écrit par une sœur qui chemine avec toi</h2>
      <p>« Je ne prétends pas être totalement guérie de tout ; mais chaque fois que j'ai fait l'expérience de la guérison, c'est Dieu qui a agi. » Race Élue anime le ministère Guérie et Épanouie depuis 2024.</p>
      <a class="link" href="/a-propos">Lire son histoire <Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="wrap sec-2 bg-sable lectrices">
    <h2 class="h2 only-desktop" style="--h2-d:44px">Ce qu'en disent les lectrices</h2>
    <div class="t-grid">
      {temoignages.map((t, i) => <div class:list={{ 'only-desktop': i > 0 }}><TestimonialCard t={t} size="lg" /></div>)}
    </div>
    {hasExamples(temoignages) && <span class="small">Textes d'exemple, à remplacer par de vrais témoignages publiés avec accord.</span>}
  </section>

  <section class="wrap sec-2 aussi only-desktop">
    <h2 class="h2" style="--h2-d:40px">À lire aussi</h2>
    <div class="aussi-grid">
      <a class="aussi-card vert on-vert" href={`/publications/${MAGAZINE.slug}`}>
        <Cover kind="magazine" width={120} shadow="sm" />
        <span class="stack aussi-txt">
          <span class="kicker or">Magazine · {MAGAZINE.numero}</span>
          <span class="aussi-titre">{MAGAZINE.titre}</span>
          <span class="link">Lire en ligne <Icon name="arrow-right" /></span>
        </span>
      </a>
      <div class="aussi-card bientot">
        <div class="placeholder-cover" aria-hidden="true">✦</div>
        <span class="stack aussi-txt">
          <span class="kicker">Bientôt</span>
          <span class="aussi-titre">Prochaine parution</span>
          <span class="desc">Sois prévenue par e-mail le jour de sa sortie.</span>
        </span>
      </div>
    </div>
  </section>

  <StickyBar slot="sticky">
    <a class="btn btn-primary" href="#recevoir">Recevoir l'ebook</a>
  </StickyBar>
</Base>

<style>
  .hero { padding-top: 20px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 20px; }
  .crumb { display: flex; gap: 10px; align-items: center; font: 600 14px var(--sans); color: var(--secondaire); flex-wrap: wrap; }
  .crumb a { color: var(--cuivre); }
  .back { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; font-size: 13px; }
  .hero-grid { display: flex; flex-direction: column; gap: 20px; }
  .cover-wrap { position: relative; width: 200px; align-self: center; margin: 12px 0; }
  .cover-arche { position: absolute; inset: -16px -28px -16px -28px; border-radius: 999px 999px 10px 10px; background: var(--vert-pale); }
  .cover-wrap :global(.cover) { position: relative; }
  .hero-txt { display: flex; flex-direction: column; gap: 20px; max-width: 600px; }
  .meta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font: 600 13px var(--sans); color: var(--secondaire); }
  .meta li { display: flex; gap: 8px; align-items: center; }
  .meta :global(.icon) { color: var(--vert); display: none; }
  .get { background: var(--creme); padding: 20px; display: flex; flex-direction: column; gap: 10px; box-shadow: none; scroll-margin-top: 24px; }
  .get-head { display: flex; justify-content: space-between; align-items: baseline; }
  .get h2 { font: 700 17px var(--sans); color: var(--encre); }
  .prix { font: 500 30px var(--serif); color: var(--vert); }
  @media (min-width: 960px) {
    .hero { padding-top: 40px; padding-bottom: 112px; gap: 48px; }
    .hero-grid { display: grid; grid-template-columns: minmax(300px, 420px) minmax(0, 1fr); gap: clamp(48px, 6.6vw, 96px); align-items: center; }
    .cover-wrap { width: min(380px, 100%); margin: 28px 40px; justify-self: center; }
    .cover-arche { inset: -28px -40px; border-radius: 999px 999px 12px 12px; }
    .hero-txt { gap: 24px; }
    .meta { gap: 28px; font-size: 14px; }
    .meta :global(.icon) { display: inline-block; }
    .get { padding: 28px; gap: 16px; box-shadow: var(--ombre-md); }
    .get h2 { font-size: 19px; }
  }

  /* Sommaire */
  .sommaire { display: flex; flex-direction: column; gap: 6px; padding-top: 56px; padding-bottom: 56px; }
  .som-intro { gap: 10px; margin-bottom: 12px; }
  .som-intro p { font-size: 17px; line-height: 1.65; }
  .toc { list-style: none; margin: 0; padding: 0; }
  .toc li { display: flex; align-items: baseline; gap: 14px; padding: 14px 0; box-shadow: inset 0 -1px 0 var(--filet); }
  .toc li:last-child { box-shadow: none; }
  .num { width: 20px; flex: none; font: italic 600 22px var(--serif); color: var(--cuivre); }
  .etoile .num { color: var(--sauge); font: 400 14px var(--sans); font-style: normal; }
  .titre { flex: 1; font: 500 20px/1.2 var(--serif); color: var(--cacao); }
  .page { font: 400 16px var(--sans); color: var(--secondaire); display: none; }
  .simple { display: none !important; }
  @media (min-width: 960px) {
    .sommaire { padding-block: var(--sec); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 96px; }
    .som-intro { gap: 20px; margin: 0; }
    .toc li { gap: 16px; padding: 16px 0; }
    .simple { display: flex !important; }
    .simple .titre { font: 400 16px var(--sans); color: var(--secondaire); }
    .num { width: 36px; font-size: 26px; }
    .titre { font-size: 24px; }
    .page { display: inline; }
  }

  /* Extrait */
  .extrait { padding-block: 56px; }
  .extrait-col { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; }
  .extrait-card { background: var(--creme); border-radius: var(--r-carte); padding: 28px 22px; display: flex; flex-direction: column; gap: 16px; }
  .extrait-card p { font-size: 16px; line-height: 1.75; }
  .drop::first-letter { font-size: 66px; margin: 6px 10px 0 0; line-height: 0.8; }
  .fade { display: none; }
  .extrait-actions { display: flex; flex-direction: column; gap: 10px; align-items: stretch; }
  .extrait-actions .btn { min-height: 52px; }
  .extrait-actions .small { display: none; }
  @media (min-width: 960px) {
    .extrait { padding-block: var(--sec); }
    .extrait-col { gap: 28px; }
    .extrait-card { padding: 56px 64px; gap: 20px; box-shadow: var(--ombre-md); }
    .extrait-card p { font-size: 19px; line-height: 1.8; }
    .drop::first-letter { font-size: 92px; margin: 8px 12px 0 0; }
    .fade { display: block; height: 72px; margin-top: -72px; position: relative; background: linear-gradient(rgba(251, 247, 241, 0), var(--creme)); }
    .extrait-actions { flex-direction: row; align-items: center; gap: 16px; }
    .extrait-actions .btn { min-height: 48px; font-size: 15px; padding: 0 22px; }
    .extrait-actions .small { display: inline; font-size: 14px; }
  }

  /* Autrice */
  .autrice { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: clamp(48px, 6.6vw, 96px); align-items: center; }
  .autrice-photo { height: 440px; border-radius: var(--arche); overflow: hidden; }
  .autrice-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .autrice-txt { gap: 20px; max-width: 620px; }
  .autrice-txt p { font-size: 18px; line-height: 1.7; }

  /* Lectrices */
  .lectrices { padding-top: 56px; padding-bottom: 120px; display: flex; flex-direction: column; gap: 16px; background: var(--creme); }
  .lectrices :global(.tcard) { background: transparent; padding: 0; }
  .t-grid { display: grid; gap: 28px; }
  @media (min-width: 960px) {
    .lectrices { background: var(--sable); padding-block: var(--sec-2); gap: 40px; }
    .lectrices :global(.tcard) { background: var(--creme); padding: 36px; }
    .t-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lectrices .small { margin-top: -12px; }
  }

  /* À lire aussi */
  .aussi { display: flex; flex-direction: column; gap: 32px; }
  .aussi-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .aussi-card { border-radius: var(--r-carte); padding: 32px; display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 28px; align-items: center; }
  a.aussi-card { transition: transform 0.18s ease-out; }
  a.aussi-card:hover { transform: translateY(-3px); }
  .aussi-card.vert { background: var(--vert); }
  .bientot { box-shadow: inset 0 0 0 1.5px var(--bordure); }
  .placeholder-cover { aspect-ratio: 3 / 4; border-radius: 3px; box-shadow: inset 0 0 0 1.5px var(--bordure); display: flex; align-items: center; justify-content: center; color: var(--sauge); font-size: 22px; }
  .aussi-txt { gap: 8px; }
  .aussi-titre { font: 500 30px/1.05 var(--serif); color: var(--cacao); }
  .vert .aussi-titre { color: var(--creme); }
  .desc { font-size: 15px; color: var(--secondaire); }
</style>
