---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import QuoteBand from '../components/QuoteBand.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import StickyBar from '../components/StickyBar.astro';
import { wa, MSG } from '../data/site';
import { premiers } from '../data/temoignages';

const activites = [
  { icon: 'chats-circle', titre: 'Partages', texte: 'Un groupe WhatsApp bienveillant pour parler librement, en toute confidentialité.' },
  { icon: 'hands-praying', titre: 'Prière', texte: 'Des temps de prière les unes pour les autres, et des sujets confiés en privé.' },
  { icon: 'microphone-stage', titre: 'Enseignements', texte: 'Des messages courts en audio ou en vidéo, légers à télécharger.' },
  { icon: 'book-bookmark', titre: 'Ressources', texte: "L'ebook, le magazine et des méditations pour continuer entre deux rencontres." },
];
const pas = [
  { titre: 'Écris-moi sur WhatsApp', texte: 'Un simple « Bonjour, je souhaite rejoindre Guérie et Épanouie » suffit.', court: 'Un simple bonjour suffit.' },
  { titre: 'On fait connaissance', texte: 'Je te présente le groupe et sa charte de bienveillance.', court: 'Je te présente la charte.' },
  { titre: 'Tu entres dans la communauté', texte: 'Tu participes comme tu veux : lire, partager ou simplement prier.', court: 'Tu participes comme tu veux.' },
];
const charte = [
  { icon: 'lock-key', titre: 'Confidentialité.', texte: 'Ce qui est partagé dans le groupe reste dans le groupe.' },
  { icon: 'heart', titre: 'Sans jugement.', texte: 'Chaque histoire est accueillie avec respect.' },
  { icon: 'plant', titre: 'À ton rythme.', texte: "Personne n'est obligée de parler." },
  { icon: 'first-aid', titre: 'Accompagnement spirituel.', texte: "Il ne remplace pas un suivi médical ou psychologique. En cas de détresse, nous t'encourageons à consulter un professionnel." },
];
// Réponses 2 à 4 rédigées d'après la charte et la page Contact : à faire valider par l'autrice.
const faq = [
  { q: "Est-ce que c'est gratuit ?", r: 'Oui, rejoindre la communauté est gratuit.' },
  { q: 'Je vis hors de la RDC, puis-je participer ?', r: "Oui. La communauté vit sur WhatsApp : tu peux la rejoindre où que tu sois, en RDC comme dans la diaspora." },
  { q: 'Dois-je raconter mon histoire ?', r: "Non. Personne n'est obligée de parler : tu peux simplement lire, prier, et partager seulement quand tu te sens prête." },
  { q: 'Peux-tu intervenir dans mon église ?', r: 'Oui, en présentiel ou en ligne.', lien: { href: '/contact?onglet=invitation', label: "Envoyer une demande d'intervention" } },
];
const temoignages = premiers(3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
};
import PageHero from '../components/PageHero.astro';
import { HERO } from '../data/hero';
---
<Base
  title="Guérie et Épanouie"
  description="Guérie et Épanouie, le ministère de Race Élue Disanka : une communauté de femmes qui avancent ensemble vers la guérison intérieure. Partages, prière, enseignements, sur WhatsApp."
  ogImage="/og/guerie.jpg"
  active="/guerie-et-epanouie"
  stickyBar
  jsonLd={jsonLd}
>
  <PageHero photos={HERO.guerie}>
    <span class="kicker or">Le ministère · depuis 2024</span>
    <h1 class="h1" style="--h1-d:76px;--h1-m:43px;--h1-vw:5.22vw">Guérie <em>et</em> Épanouie</h1>
    <p class="lead only-desktop">Une communauté de femmes qui avancent ensemble vers la guérison intérieure. On y partage, on y prie, on y apprend à se laisser aimer par Dieu. Tu peux venir comme tu es.</p>
    <p class="lead only-mobile">Une communauté de femmes qui avancent ensemble vers la guérison intérieure. Viens comme tu es.</p>
    <div class="btns">
      <a class="btn btn-gold btn-lg" href={wa(MSG.communaute)} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp-logo" size={24} />Rejoindre la communauté</a>
      <a class="link only-desktop" href="#rejoindre">Comment ça marche</a>
    </div>
  </PageHero>

  <section class="wrap sec pourquoi">
    <div class="pq-fond" aria-hidden="true"><Photo src="studio-nb.jpg" alt="" sizes="100vw" position="50% 30%" /></div>
    <div class="stack gap18">
      <span class="kicker">Pourquoi ce ministère</span>
      <h2 class="h2" style="--h2-d:45px;--h2-m:27px">Beaucoup de femmes sourient <em>en portant des blessures</em></h2>
    </div>
    <div class="stack pourquoi-txt">
      <p class="only-desktop">En 2024, Dieu a déposé dans mon cœur le fardeau de parler des blessures intérieures. Guérie et Épanouie est né de cet appel : un espace sûr où l'on peut enfin dire ce qui fait mal, et découvrir que Dieu guérit vraiment.</p>
      <p class="only-desktop">Ici, personne ne te juge. On avance chacune à son rythme, et on se rappelle que la guérison est un chemin, pas une performance.</p>
      <p class="only-mobile">En 2024, Dieu a déposé dans mon cœur le fardeau de parler des blessures intérieures. Ici, personne ne te juge : on avance chacune à son rythme.</p>
      <span class="sign only-desktop">Race Élue</span>
    </div>
  </section>

  <section class="wrap sec activites on-vert">
    <!-- Photo en fond de la partie, les cartes posées par-dessus (demande de Mazunda du 10/10/2026) -->
    <div class="act-fond" aria-hidden="true">
      <Photo src="stage.jpg" alt="" sizes="100vw" position="45% 34%" />
    </div>
    <div class="stack gap14">
      <span class="kicker or only-desktop">Ce que nous vivons ensemble</span>
      <h2 class="h2" style="--h2-d:45px;--h2-m:27px"><span class="only-desktop">Quatre rendez-vous pour grandir</span><span class="only-mobile">Ce que nous vivons ensemble</span></h2>
    </div>
    <div class="act-grid">
      {activites.map((a, i) => (
        <div class="act">
          <span class="act-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{a.titre}</h3>
          <p class="only-desktop">{a.texte}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap sec rejoindre" id="rejoindre">
    <div class="stack rej-txt">
      <div class="stack gap14">
        <span class="kicker only-desktop">Nous rejoindre</span>
        <h2 class="h2" style="--h2-d:45px;--h2-m:27px">Trois pas, <em>à ton rythme</em></h2>
      </div>
      <ol class="pas">
        {pas.map((p, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <span class="stack"><strong>{p.titre}</strong><span class="only-desktop">{p.texte}</span><span class="only-mobile">{p.court}</span></span>
          </li>
        ))}
      </ol>
      <a class="btn btn-primary btn-lg only-desktop wa-cta" href={wa(MSG.communaute)} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp-logo" size={24} />Écrire sur WhatsApp</a>
    </div>
    <div class="charte">
      <span class="kicker"><span class="only-desktop">Notre charte de bienveillance</span><span class="only-mobile">Charte de bienveillance</span></span>
      <ul class="only-desktop">
        {charte.map((c) => <li><Icon name={c.icon} size={22} /><span><strong>{c.titre}</strong> {c.texte}</span></li>)}
      </ul>
      <ul class="only-mobile">
        <li><Icon name="lock-key" size={20} /><span>Confidentialité, sans jugement, à ton rythme.</span></li>
        <li><Icon name="first-aid" size={20} /><span>Accompagnement spirituel, qui ne remplace pas un suivi médical ou psychologique.</span></li>
      </ul>
    </div>
  </section>

  <QuoteBand photo="herbe-sourire.jpg" position="50% 45%" trait texte="Je suis guérie et épanouie !" note="La déclaration que chaque membre est invitée à faire sienne, un jour après l'autre." size={64} />

  {temoignages.length > 0 && (
  <section class="wrap sec-2 bg-sable elles">
    <h2 class="h2 only-desktop" style="--h2-d:41px">Elles en parlent</h2>
    <div class="t-grid">
      {temoignages.map((t, i) => <div class:list={{ 'only-desktop': i > 0 }}><TestimonialCard t={t} /></div>)}
    </div>
  </section>
  )}

  <section class="wrap sec-2 faq">
    <h2 class="h2" style="--h2-d:41px;--h2-m:27px">Tes questions</h2>
    <div class="faq-list">
      {faq.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}<span class="pm" aria-hidden="true"><Icon name="plus" class="plus" /><Icon name="minus" class="minus" /></span></summary>
          <p>{f.r} {f.lien && <a href={f.lien.href}>{f.lien.label}</a>}</p>
        </details>
      ))}
    </div>
  </section>

  <StickyBar slot="sticky" withWhatsApp={false}>
    <a class="btn btn-wa" href={wa(MSG.communaute)} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp-logo" size={24} />Rejoindre sur WhatsApp</a>
  </StickyBar>
</Base>

<style>
  .gap14 { gap: 14px; }
  .gap18 { gap: 16px; }
  .btns { display: flex; flex-direction: column; gap: 16px; }
  .btns .btn { min-height: 54px; font-size: 14px; }
  @media (min-width: 960px) {
    .btns { flex-direction: row; align-items: center; }
    .btns .btn { min-height: 56px; font-size: 15px; }
    .btns .link { color: var(--creme); font-size: 14px; }
  }

  .pourquoi { position: relative; isolation: isolate; overflow: hidden; padding-block: 56px; display: flex; flex-direction: column; gap: 16px; }
  /* Portrait en filigrane sous un voile crème : de la matière sans gêner la lecture */
  .pq-fond { position: absolute; inset: 0; z-index: -1; }
  .pq-fond :global(picture), .pq-fond :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pq-fond::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(251, 247, 241, 0.92) 0%, rgba(251, 247, 241, 0.95) 45%, rgba(251, 247, 241, 0.97) 100%); }
  .pourquoi-txt { gap: 20px; }
  .pourquoi-txt p { font-size: 14px; line-height: 1.7; }
  .sign { font: italic 500 23px var(--serif); color: var(--cuivre); }
  @media (min-width: 960px) {
    .pourquoi { padding-block: var(--sec); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 96px; align-items: start; }
    .pourquoi-txt { padding-top: 28px; }
    .pourquoi-txt p { font-size: 17px; line-height: 1.75; }
  }

  .activites { position: relative; isolation: isolate; overflow: hidden; background: var(--vert); padding-block: 56px; display: flex; flex-direction: column; gap: 20px; }
  .act-fond { position: absolute; inset: 0; z-index: -1; }
  .act-fond :global(picture), .act-fond :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Voile vert léger : la photo reste visible entre les cartes, le titre reste lisible. */
  .act-fond::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(30, 59, 47, 0.9) 0%, rgba(30, 59, 47, 0.8) 45%, rgba(30, 59, 47, 0.86) 100%); }
  .activites h2 { color: var(--creme); text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35); }
  .activites .kicker.or { color: var(--or-couv); }
  .act-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 359.98px) { .act-grid { grid-template-columns: 1fr; } }
  .act { background: rgba(251, 247, 241, 0.94); border-radius: var(--r-carte); padding: 18px; display: flex; flex-direction: column; gap: 8px;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.55); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .act h3 { color: var(--cacao); }
  .act p { color: var(--encre); }
  .act-num { font: italic 500 28px/1 var(--serif); color: var(--cuivre); display: flex; align-items: center; gap: 12px; }
  .act-num::after { content: ''; height: 1px; flex: 1; background: linear-gradient(90deg, var(--or), transparent); }
  .act h3 { font-size: 20px; line-height: 1.1; }
  .act p { font-size: 14px; line-height: 1.6; }
  @media (min-width: 960px) {
    .activites { padding-block: var(--sec); gap: 56px; }
    .act-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
    .act { padding: 32px 28px; gap: 14px; }
    .act-num { font-size: 34px; }
    .act h3 { font-size: 25px; }
  }

  .rejoindre { padding-block: 56px; display: flex; flex-direction: column; gap: 22px; scroll-margin-top: 16px; }
  .rej-txt { gap: 22px; }
  .pas { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 22px; }
  .pas li { display: flex; gap: 16px; align-items: flex-start; }
  .num { width: 44px; height: 44px; flex: none; border-radius: 999px 999px 5px 5px; background: var(--vert); color: var(--or); display: flex; align-items: center; justify-content: center; font: italic 600 20px var(--serif); }
  .pas strong { font: 700 14px var(--sans); color: var(--encre); }
  .pas .stack span { font-size: 13px; line-height: 1.5; color: var(--secondaire); }
  .pas .stack { max-width: 30em; }
  .charte { background: var(--sable); border-radius: var(--r-carte); padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .charte ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .charte li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.55; }
  .charte li :global(.icon) { color: var(--vert); margin-top: 2px; }
  @media (min-width: 960px) {
    .rejoindre { padding-block: var(--sec); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 96px; align-items: center; }
    .rej-txt { gap: 36px; }
    .pas { gap: 28px; }
    .pas li { gap: 24px; }
    .num { width: 56px; height: 56px; border-radius: 999px 999px 6px 6px; font-size: 25px; }
    .pas strong { font-size: 17px; }
    .pas .stack { gap: 4px; }
    .pas .stack span { font-size: 14px; line-height: 1.6; }
    .wa-cta { align-self: flex-start; }
    .charte { border-radius: var(--r-bandeau); padding: 48px; gap: 22px; }
    .charte ul { gap: 22px; }
    .charte li { gap: 16px; font-size: 15px; line-height: 1.6; }
    .charte li :global(.icon) { margin-top: 0; }
  }

  .elles { padding-top: 56px; padding-bottom: 8px; background: var(--creme); display: flex; flex-direction: column; gap: 14px; }
  .elles :global(.tcard) { background: transparent; padding: 0; }
  .t-grid { display: grid; gap: 28px; }
  @media (min-width: 960px) {
    .elles { padding-block: var(--sec-2); background: var(--sable); gap: 40px; }
    .elles :global(.tcard) { background: var(--creme); padding: 32px; }
    .t-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .elles .small { margin-top: -12px; }
  }

  .faq { padding-top: 48px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 16px; }
  .faq-list details { box-shadow: inset 0 -1px 0 var(--filet); }
  .faq-list details:last-child { box-shadow: none; }
  summary {
    list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 18px 0; min-height: 44px; cursor: pointer; font: 700 14px var(--sans); color: var(--encre);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--cuivre); }
  .pm { color: var(--cuivre); display: inline-flex; }
  .pm :global(.minus) { display: none; }
  details[open] .pm :global(.minus) { display: inline-block; }
  details[open] .pm :global(.plus) { display: none; }
  details p { padding: 0 0 20px; font-size: 14px; line-height: 1.65; }
  @media (min-width: 960px) {
    .faq { padding-block: var(--sec-2); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 96px; align-items: start; }
    summary { padding: 24px 0; font-size: 16px; }
    details p { margin-top: -10px; padding-bottom: 24px; }
  }
</style>
