---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import Cover from '../../components/Cover.astro';
import StickyBar from '../../components/StickyBar.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import { THEMES, kickerCarte, titreComplet, type Pensee } from '../../data/pensees';
import { chargerPensees } from '../../data/blog';
import { EBOOK, MAGAZINE, SITE } from '../../data/site';

export async function getStaticPaths() {
  const liste = await chargerPensees();
  return liste.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
interface Props { p: Pensee }
const { p } = Astro.props;
const PENSEES = await chargerPensees();
const extrait = typeof p.page === 'number';
const titre = titreComplet(p);
const suivantes = PENSEES.filter((x) => x.slug !== p.slug).slice(0, 2);
const url = new URL(`/pensees/${p.slug}`, Astro.site).href;
const partage = `https://wa.me/?text=${encodeURIComponent(`« ${titre} », une pensée de Race Élue Disanka : ${url}`)}`;
const premierP = p.corps.findIndex((b) => b.type === 'p');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titre,
  author: { '@type': 'Person', name: SITE.nom },
  publisher: { '@type': 'Organization', name: SITE.editeur },
  datePublished: p.dateIso,
  ...(extrait ? { isPartOf: { '@type': 'PublicationIssue', name: `${MAGAZINE.titre} ${MAGAZINE.numero}` } } : {}),
  inLanguage: 'fr',
  mainEntityOfPage: url,
};
import PageHero from '../../components/PageHero.astro';
import { photoPensee } from '../../data/hero';
---
<Base
  title={titre}
  description={p.resume}
  ogType="article"
  ogImage={`/og/pensees/${p.slug}.jpg`}
  active="/pensees"
  headerVariant="article"
  footerMention=""
  stickyBar
  jsonLd={jsonLd}
>
  <div slot="top" class="progress" aria-hidden="true"><span data-progress></span></div>

  <PageHero photos={photoPensee(p)}>
    <nav class="crumb only-desktop" aria-label="Fil d'Ariane">
      <a href="/pensees">Blog</a><Icon name="caret-right" size={14} /><a href={`/pensees?theme=${p.theme}`}>{THEMES[p.theme]}</a>
    </nav>
    <span class="kicker or">{THEMES[p.theme]} · {p.duree} de lecture</span>
    <h1 class="h1" style="--h1-d:65px;--h1-m:38px;--h1-vw:4.5vw">{p.titre}{p.titreEm && <> <em>{p.titreEm}</em></>}</h1>
    <div class="byline">
      <span class="avatar"><Photo src="portrait-arches.jpg" alt="" position="center 18%" sizes="44px" /></span>
      <span><strong>Race Élue</strong> · <time datetime={p.dateIso}>{p.date}</time>{extrait && <> · extrait du magazine {MAGAZINE.numero}</>}</span>
    </div>
  </PageHero>

  <div class="art-grid">
    <aside class="share-side only-desktop" aria-label="Partager">
      <span class="share-k">Partager</span>
      <a class="share-btn wa" href={partage} target="_blank" rel="noopener noreferrer" aria-label="Partager sur WhatsApp"><Icon name="whatsapp-logo" size={22} /></a>
      <button type="button" class="share-btn" data-copy={url} aria-label="Copier le lien"><Icon name="link-simple" size={22} /></button>
      <span class="copied" role="status" data-copied hidden>Lien copié</span>
    </aside>

    <article class="art">
      <div class="corps">
        {p.corps.map((b, i) => {
          if (b.type === 'p') return b.html ? <p class:list={{ drop: i === premierP }} set:html={b.html} /> : <p class:list={{ drop: i === premierP }}>{b.texte}</p>;
          if (b.type === 'h2') return <h2>{b.texte}</h2>;
          if (b.type === 'verset') return (
            <blockquote class="verset on-vert">
              <span class="vq only-desktop" aria-hidden="true">“</span>
              <p>{b.texte}</p>
              <cite>{b.ref}</cite>
            </blockquote>
          );
          if (b.type === 'video') return <YouTubeFacade youtubeId={b.youtubeId} titre={titre} duree={b.duree} photo={p.photo} url={p.photoUrl} position={p.position} />;
          return null;
        })}
        {p.video && !p.corps.some((b) => b.type === 'video') && (
          <YouTubeFacade youtubeId={p.video.youtubeId} titre={titre} duree={p.video.duree} photo={p.photo} url={p.photoUrl} position={p.position} />
        )}
        {p.priere && (
          <div class="priere">
            <span class="priere-k"><Icon name="hands-praying" size={22} />Prière</span>
            <p>{p.priere}</p>
          </div>
        )}
        {extrait && <p class="source">Extrait du magazine <a href={`/publications/${MAGAZINE.slug}#page-${p.page}`}>« {MAGAZINE.titre} », {MAGAZINE.numero}</a>{p.rubrique && <>, rubrique « {p.rubrique} »</>}.</p>}
      </div>

      <div class="share-row only-desktop">
        <span>Cette pensée t'a fait du bien ?</span>
        <a class="btn btn-wa btn-md" href={partage} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp-logo" />La partager</a>
      </div>
    </article>
  </div>

  <section class="wrap suite">
    <h2 class="h2 only-desktop" style="--h2-d:36px">À lire ensuite</h2>
    <span class="suite-m only-mobile">À lire ensuite</span>
    <div class="suite-grid">
      {suivantes.map((s, i) => (
        <a class:list={['next card', { 'only-desktop-flex': i > 0 }]} href={`/pensees/${s.slug}`}>
          <span class="k">{kickerCarte(s)}</span>
          <span class="t">{titreComplet(s)}</span>
          <Icon name="caret-right" class="caret only-mobile" />
        </a>
      ))}
      <a class="next ebook only-desktop" href={`/publications/${EBOOK.slug}`}>
        <span class="mini"><Cover kind="ebook" width={70} shadow="sm" /></span>
        <span class="stack"><span class="k cuivre">Ebook gratuit</span><span class="t small-t">{EBOOK.titre}</span></span>
      </a>
    </div>
  </section>

  <StickyBar slot="sticky" withWhatsApp={false}>
    <a class="btn btn-wa" href={partage} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp-logo" />Partager cette pensée</a>
  </StickyBar>
</Base>

<script>
  // Barre de progression de lecture
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const art = document.querySelector<HTMLElement>('.art');
  if (bar && art) {
    let ticking = false;
    const update = () => {
      const r = art.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const done = Math.min(Math.max(-r.top / Math.max(total, 1), 0), 1);
      bar.style.transform = `scaleX(${done})`;
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
  // Copier le lien
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(b.dataset.copy!);
      const msg = document.querySelector<HTMLElement>('[data-copied]');
      if (msg) { msg.hidden = false; setTimeout(() => (msg.hidden = true), 2000); }
    } catch { prompt('Copie ce lien :', b.dataset.copy); }
  }));
</script>

<style>
  .progress { position: fixed; left: 0; right: 0; top: 0; z-index: 50; height: 3px; background: var(--filet); }
  .progress span { display: block; height: 100%; background: var(--cuivre); transform-origin: left; transform: scaleX(0); }
  @media (min-width: 960px) { .progress { height: 4px; } }

  .art-grid { padding: 28px var(--gutter) 40px; }
  .art { display: flex; flex-direction: column; gap: 18px; max-width: 720px; margin: 0 auto; }
  .crumb { display: flex; gap: 10px; align-items: center; font: 600 13px var(--sans); color: var(--secondaire); }
  .art h1 { line-height: 1; }
  .byline { display: flex; gap: 14px; align-items: center; font: 400 12px var(--sans); color: var(--texte-vert); }
  .byline strong { color: var(--creme); font-weight: 600; }
  .avatar { box-shadow: 0 0 0 2px var(--or); }
  .avatar { width: 44px; height: 44px; flex: none; border-radius: 999px; overflow: hidden; }
  .avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero-img { height: 250px; border-radius: 999px 999px 8px 8px; overflow: hidden; }
  .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .corps { display: flex; flex-direction: column; gap: 18px; }
  .corps > p { font-size: 15px; line-height: 1.75; max-width: 30em; }
  .corps > p.source { font-size: 13px; line-height: 1.55; color: var(--secondaire); }
  .corps .drop::first-letter { font-size: 68px; margin: 8px 10px 0 0; line-height: 0.8; }
  .corps h2 { font-size: 25px; line-height: 1.1; margin-top: 8px; }
  .verset { margin: 0; background: var(--vert); border-radius: 999px 999px 10px 10px; padding: 72px 36px 32px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .verset p { font: italic 500 22px/1.25 var(--serif); color: var(--creme); }
  .verset cite { font: 800 12px var(--sans); font-style: normal; letter-spacing: 0.22em; text-transform: uppercase; color: var(--or); }
  .vq { font: 500 72px/0.5 var(--serif); color: var(--or); padding-top: 28px; }
  .priere { background: var(--vert-pale); border-radius: var(--r-carte); padding: 24px 22px; display: flex; flex-direction: column; gap: 10px; }
  .priere-k { display: flex; gap: 8px; align-items: center; font: 800 12px var(--sans); letter-spacing: 0.22em; text-transform: uppercase; color: var(--vert); }
  .priere-k :global(.icon) { color: var(--cuivre); }
  .priere p { font: italic 500 19px/1.45 var(--serif); color: var(--encre); }

  @media (min-width: 960px) {
    .art-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 720px) minmax(0, 1fr); padding: 72px 0 0; }
    .art { gap: 28px; margin: 0; grid-column: 2; }
    .byline { font-size: 13px; }
    .hero-img { height: 420px; border-radius: 999px 999px 12px 12px; margin: 12px 0; }
    .corps { gap: 28px; }
    .corps > p { font-size: 18px; line-height: 1.8; }
    .corps > p.source { font-size: 14px; }
    .corps .drop::first-letter { font-size: 94px; margin: 10px 14px 0 0; }
    .corps h2 { font-size: 34px; margin-top: 16px; }
    .verset { margin: 16px 0; padding: 40px 48px; border-radius: 999px 999px 12px 12px; gap: 12px; }
    .verset p { font-size: 29px; }
    .verset cite { font-size: 12px; }
    .priere { padding: 36px 40px; gap: 14px; margin-top: 12px; }
    .priere-k { font-size: 12px; }
    .priere p { font-size: 22px; }
  }

  /* Partage (colonne gauche, ordinateur) */
  .share-side { grid-column: 1; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; padding: 8px 48px 0 0; position: sticky; top: 24px; align-self: start; }
  .share-k { font: 800 12px var(--sans); letter-spacing: 0.2em; color: var(--secondaire); text-transform: uppercase; }
  .share-btn { width: 48px; height: 48px; border-radius: 999px; border: 0; background: none; box-shadow: inset 0 0 0 1px var(--bordure); display: flex; align-items: center; justify-content: center; color: var(--vert); cursor: pointer; }
  .share-btn.wa { color: var(--whatsapp); }
  .share-btn:hover { background: var(--sable); }
  .copied { font: 600 12px var(--sans); color: var(--vert); }
  .share-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 28px 0; margin-top: 16px; box-shadow: inset 0 1px 0 var(--filet), inset 0 -1px 0 var(--filet); }
  .share-row span { font: 700 14px var(--sans); color: var(--encre); }

  /* À lire ensuite */
  .suite { padding-bottom: 40px; display: flex; flex-direction: column; gap: 12px; }
  .suite-m { font: 700 14px var(--sans); color: var(--encre); }
  .suite-grid { display: flex; flex-direction: column; }
  .next { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 0; min-height: 44px; color: inherit; background: none; box-shadow: inset 0 -1px 0 var(--filet); border-radius: 0; }
  .next .k { display: none; }
  .next .t { font: 500 19px/1.15 var(--serif); color: var(--cacao); }
  .next :global(.caret) { color: var(--cuivre); }
  @media (max-width: 959.98px) { .only-desktop-flex { display: none !important; } }
  @media (min-width: 960px) {
    .suite { padding-top: 64px; padding-bottom: var(--sec-2); gap: 32px; }
    .suite-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
    .next { flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 10px; padding: 26px; background: #fff; border-radius: var(--r-carte); box-shadow: var(--ombre-md); transition: transform 0.18s ease-out; }
    .next:hover { transform: translateY(-3px); color: inherit; }
    .next .k { display: block; font: 800 12px var(--sans); letter-spacing: 0.2em; text-transform: uppercase; color: var(--vert); }
    .next .k.cuivre { color: var(--cuivre); }
    .next .t { font-size: 23px; line-height: 1.12; }
    .next .small-t { font-size: 20px; }
    .ebook { background: var(--sable); box-shadow: none; display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 18px; align-items: center; }
    .ebook .stack { gap: 6px; }
  }
</style>
