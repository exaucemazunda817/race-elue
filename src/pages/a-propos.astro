---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import QuoteBand from '../components/QuoteBand.astro';
import StickyBar from '../components/StickyBar.astro';
import Rameau from '../components/Rameau.astro';
import { RESEAUX, SITE } from '../data/site';

const mission = [
  { n: '01', photo: 'studio-laugh.jpg', pos: 'center 30%', alt: 'Race Élue rit, assise en studio devant un cœur lumineux', titre: 'La foi', texte: 'Ramener chaque blessure à la Parole et à la présence de Dieu, sans recette ni jugement.', court: 'Ramener chaque blessure à la présence de Dieu.' },
  { n: '02', photo: 'laptop.jpg', pos: 'center 28%', alt: 'Race Élue rit devant son ordinateur portable', titre: 'La créativité', texte: "Écrire, publier, créer : laisser l'élan que Dieu a déposé en nous redevenir une source de vie.", court: "Laisser l'élan créatif redevenir source de vie." },
  { n: '03', photo: 'grass.jpg', pos: 'center 45%', alt: "Race Élue assise dans l'herbe", titre: 'La guérison intérieure', texte: "Nommer ce qui fait mal et marcher, avec d'autres, vers un cœur guéri et épanoui.", court: "Marcher, avec d'autres, vers un cœur épanoui." },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.nom,
  jobTitle: 'Autrice, fondatrice du ministère Guérie et Épanouie',
  url: new URL('/a-propos', Astro.site).href,
  sameAs: RESEAUX.map((r) => r.url),
  memberOf: { '@type': 'Church', name: 'Église missionnaire Parole faite chair' },
};
import PageHero from '../components/PageHero.astro';
import { HERO } from '../data/hero';
---
<Base
  title="À propos"
  description="Race Élue Disanka, autrice chrétienne et fondatrice du ministère Guérie et Épanouie : son histoire, sa mission, et comment l'inviter à intervenir."
  ogImage="/og/race-elue.jpg"
  active="/a-propos"
  stickyBar
  jsonLd={jsonLd}
>
  <PageHero photos={HERO.apropos}>
    <span class="kicker or">À propos</span>
    <h1 class="h1" style="--h1-d:72px;--h1-m:43px;--h1-vw:4.95vw">Race Élue <em>Disanka</em></h1>
    <span class="sous-titre">Autrice, fondatrice du ministère Guérie et Épanouie</span>
    <p class="lead">J'écris et je parle de foi, de créativité et de guérison des blessures intérieures.<span class="only-desktop"> Mon désir : que chaque femme blessée sache que Dieu n'a pas fini avec elle.</span></p>
    <div class="btns only-desktop">
      <a class="btn btn-primary btn-md" href="/contact?onglet=invitation">M'inviter à intervenir</a>
      <a class="link" href="/publications">Lire mes publications <Icon name="arrow-right" /></a>
    </div>
  </PageHero>

  <section class="wrap sec bg-sable histoire">
    <div class="col">
      <span class="kicker">Mon histoire</span>
      <h2 class="h2" style="--h2-d:47px;--h2-vw:3.24vw">Un appel reçu en 2024</h2>
      <p class="drop">En 2024, Dieu a déposé dans mon cœur le fardeau de parler des blessures intérieures. J'ai compris que beaucoup de femmes autour de moi souriaient en portant des douleurs qu'elles n'osaient pas nommer.</p>
      <p>Je ne prétends pas être totalement guérie de tout. Mais chaque fois que j'ai fait l'expérience de la guérison, c'est Dieu qui a agi.<span class="suite-mobile"> C'est ce chemin que je partage dans mes écrits, sur mes réseaux et au sein du ministère Guérie et Épanouie.</span></p>
      <div class="more-wrap" data-more-wrap>
        <p>Avec RED Éditions, je publie des ressources simples et accessibles : un ebook, un magazine de la foi, des pensées et des méditations, pour que tu puisses avancer à ton rythme, où que tu sois.</p>
        <Rameau class="histoire-rameau" />
        <span class="sign">Race Élue</span>
      </div>
      <button type="button" class="link read-more only-mobile" data-read-more aria-expanded="false">Lire la suite <Icon name="caret-down" /></button>
    </div>
  </section>

  <QuoteBand photo="studio-posee.jpg" position="50% 35%" texte="Chaque fois que j'ai fait l'expérience de la guérison, c'est Dieu qui a agi." source="Comment Dieu guérit les cœurs brisés" sourceMobile="" size={50} />

  <section class="wrap sec mission">
    <div class="stack gap14">
      <span class="kicker only-desktop">Ma mission</span>
      <h2 class="h2" style="--h2-d:45px"><span class="only-desktop">Trois fils qui tiennent ensemble</span><span class="only-mobile">Ma mission</span></h2>
    </div>
    <div class="m-grid">
      {mission.map((m) => (
        <article class="fil">
          <div class="fil-img"><Photo src={m.photo} alt={m.alt} position={m.pos} sizes="(min-width: 960px) 400px, 80vw" /></div>
          <div class="fil-txt">
            <span class="n" aria-hidden="true">{m.n}</span>
            <h3>{m.titre}</h3>
            <p>{m.texte}</p>
          </div>
        </article>
      ))}
    </div>
  </section>


  <section class="wrap sec-2 eglise on-vert">
    <div class="eglise-fond" aria-hidden="true"><Photo src="stage.jpg" alt="" sizes="100vw" position="40% 30%" /></div>
    <div class="stack eglise-txt">
      <span class="kicker or">Mon église</span>
      <h2 class="h2" style="--h2-d:41px">Enracinée dans une communauté locale</h2>
      <p>Je suis membre de l'Église missionnaire Parole faite chair, à Kinshasa, conduite par mon père spirituel, le pasteur David Kalonji. Mon ministère se vit en lien avec elle.</p>
    </div>
    <div class="invit">
      <span class="invit-titre">Tu organises un culte, une conférence ou une retraite ?</span>
      <p class="only-desktop">Je peux intervenir sur la guérison intérieure, l'identité en Dieu et la foi créative, en présentiel ou en ligne.</p>
      <p class="only-mobile">J'interviens en présentiel ou en ligne.</p>
      <a class="btn btn-primary btn-md only-desktop" href="/contact?onglet=invitation">Envoyer une invitation</a>
    </div>
  </section>

  <StickyBar slot="sticky">
    <a class="btn btn-primary" href="/contact?onglet=invitation">M'inviter à intervenir</a>
  </StickyBar>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-read-more]');
  const wrap = document.querySelector<HTMLElement>('[data-more-wrap]');
  if (btn && wrap) {
    wrap.classList.add('js-collapsed');
    document.querySelector('.suite-mobile')?.classList.add('js-collapsed');
    btn.addEventListener('click', () => {
      document.querySelectorAll('.js-collapsed').forEach((el) => el.classList.remove('js-collapsed'));
      btn.remove();
    });
  }
</script>

<style>
  .gap14 { gap: 14px; }
  .sous-titre { font: italic 500 19px/1.3 var(--serif); color: var(--or-couv); }
  .btns { display: flex; gap: 16px; align-items: center; }
  @media (min-width: 960px) {
    .sous-titre { font-size: 25px; }
  }

  .histoire { padding-block: 56px; }
  .col { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
  .col p { font-size: 14px; line-height: 1.75; }
  .col .drop::first-letter { font-size: 63px; margin: 6px 10px 0 0; line-height: 0.8; }
  .more-wrap { display: flex; flex-direction: column; gap: 16px; }
  .sign { font: italic 500 25px var(--serif); color: var(--cuivre); margin-top: 8px; }
  .col :global(.histoire-rameau) { margin: 8px 0 0; }
  .read-more { background: none; border: 0; padding: 0; cursor: pointer; align-self: flex-start; }
  @media (max-width: 959.98px) { :global(.js-collapsed) { display: none !important; } }
  @media (min-width: 960px) {
    .histoire { padding-block: var(--sec); }
    .col { gap: 24px; }
    .col h2 { margin-bottom: 8px; }
    .col p { font-size: 17px; line-height: 1.8; }
    .col .drop::first-letter { font-size: 86px; margin: 8px 14px 0 0; }
    .suite-mobile { display: none; }
    .more-wrap { gap: 24px; }
  }

  /* Trois fils : trois cartes avec photo en arche (refonte du 10/10/2026). Téléphone : rangée qui glisse. */
  .mission { padding-block: 56px; display: flex; flex-direction: column; gap: 24px; background: var(--sable); }
  .m-grid {
    display: grid; grid-auto-flow: column; grid-auto-columns: 80%; gap: 16px; overflow-x: auto;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); margin-inline: calc(-1 * var(--gutter));
    padding: 8px var(--gutter) 28px; scrollbar-width: none;
  }
  .m-grid::-webkit-scrollbar { display: none; }
  .fil {
    scroll-snap-align: start; display: flex; flex-direction: column; background: #fff; border-radius: 999px 999px 16px 16px;
    overflow: hidden; box-shadow: 0 2px 4px rgba(74, 42, 26, 0.06), 0 22px 44px -22px rgba(74, 42, 26, 0.35);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .fil-img { aspect-ratio: 4 / 3.4; overflow: hidden; }
  .fil-img :global(picture), .fil-img :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .fil-txt { padding: 20px 22px 26px; display: flex; flex-direction: column; gap: 10px; }
  .n { font: italic 500 26px/1 var(--serif); color: var(--cuivre); display: flex; align-items: center; gap: 12px; }
  .n::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--or), transparent); }
  .fil h3 { font-size: 25px; line-height: 1.1; }
  .fil p { font-size: 14px; line-height: 1.6; color: var(--encre); }
  @media (min-width: 960px) {
    .mission { padding-block: var(--sec); gap: 48px; }
    .m-grid { grid-auto-flow: row; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-columns: auto; gap: 32px; overflow: visible; margin: 0; padding: 0; }
    .fil:hover { transform: translateY(-6px); box-shadow: 0 2px 4px rgba(74, 42, 26, 0.06), 0 32px 60px -24px rgba(74, 42, 26, 0.45); }
    .fil:hover .fil-img :global(img) { transform: scale(1.05); }
    .fil-txt { padding: 28px 32px 34px; gap: 12px; }
    .n { font-size: 32px; }
    .fil h3 { font-size: 31px; }
    .fil p { font-size: 15px; line-height: 1.65; }
  }

  .eglise { position: relative; isolation: isolate; overflow: hidden; padding-block: 56px; background: var(--vert); }
  .eglise-fond { position: absolute; inset: 0; z-index: -1; }
  .eglise-fond :global(picture), .eglise-fond :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .eglise-fond::after { content: ''; position: absolute; inset: 0; background: rgba(30, 59, 47, 0.78); }
  .eglise h2 { color: var(--creme); }
  .eglise .kicker.or { color: var(--or-couv); }
  .invit { box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.55); }
  .eglise-txt { display: none; }
  .invit { background: var(--vert-pale); border-radius: var(--r-bandeau); padding: 28px 22px; display: flex; flex-direction: column; gap: 14px; }
  .invit-titre { font: 500 23px/1.1 var(--serif); color: var(--cacao); }
  .invit p { font-size: 14px; line-height: 1.55; }
  @media (min-width: 960px) {
    .eglise-fond::after { background: linear-gradient(90deg, rgba(30, 59, 47, 0.95) 0%, rgba(30, 59, 47, 0.9) 42%, rgba(30, 59, 47, 0.62) 100%); }
    .eglise-txt p { color: var(--texte-vert); }
    .eglise { padding-block: var(--sec); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 96px; align-items: center; }
    .eglise-txt { display: flex; gap: 18px; }
    .eglise-txt p { font-size: 16px; line-height: 1.7; max-width: 34em; }
    .invit { background: var(--creme); padding: 44px; gap: 20px; }
    .invit-titre { font-size: 32px; }
    .invit p { font-size: 15px; line-height: 1.65; }
    .invit .btn { align-self: flex-start; }
  }
</style>
