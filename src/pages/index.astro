---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import PubCards from '../components/PubCards.astro';
import PageHero from '../components/PageHero.astro';
import { HERO } from '../data/hero';
import Rameau from '../components/Rameau.astro';
import QuoteBand from '../components/QuoteBand.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import { RESEAUX, EBOOK, MAGAZINE, SITE, wa, MSG } from '../data/site';
import { premiers } from '../data/temoignages';

const temoignages = premiers(3);
const heroPhotos = HERO.accueil;
const portes = [
  { icon: 'heart', titre: 'Guérir', texte: 'Mettre des mots sur tes blessures et laisser Dieu les soigner.', court: 'Laisser Dieu soigner tes blessures', href: `/publications/${EBOOK.slug}` },
  { icon: 'sun-horizon', titre: 'Croire', texte: 'Des histoires bibliques et des témoignages pour fortifier ta foi.', court: 'Fortifier ta foi', href: `/publications/${MAGAZINE.slug}` },
  { icon: 'pen-nib', titre: 'Créer', texte: "Retrouver l'élan créatif que Dieu a déposé en toi.", court: 'Retrouver ton élan créatif', href: '/pensees?theme=creativite' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.nom,
  description: 'Autrice chrétienne, fondatrice du ministère Guérie et Épanouie.',
  url: Astro.site?.href,
  sameAs: RESEAUX.map((r) => r.url),
};
---
<Base title={SITE.nom} footer="full" jsonLd={jsonLd}>
  <!-- Héros : photo pleine largeur, les photos se succèdent (PageHero) -->
  <PageHero size="accueil" photos={heroPhotos} cote="droite">
    <span class="kicker or"><span class="only-desktop">Foi · Créativité · Guérison intérieure</span><span class="only-mobile">Foi · Créativité · Guérison</span></span>
    <h1 class="h1 home-h1">Ton cœur peut guérir. <em>Dieu n'a pas fini avec toi.</em></h1>
    <p class="lead only-desktop">Je suis Race Élue. J'écris pour celles qui portent des blessures en silence, et je partage ce que Dieu fait dans les cœurs brisés, pour que tu avances à ton rythme vers la guérison.</p>
    <p class="lead only-mobile">Je suis Race Élue. Je partage ce que Dieu fait dans les cœurs brisés, pour que tu avances à ton rythme vers la guérison.</p>
    <div class="btns">
      <a class="btn btn-gold btn-lg" href={`/publications/${EBOOK.slug}#recevoir`}>Recevoir l'ebook gratuit</a>
      <a class="btn btn-ghost-light btn-lg" href={`/publications/${MAGAZINE.slug}`}>Lire le magazine</a>
    </div>
    <span class="signature only-desktop">« Je suis guérie et épanouie ! »<svg class="trait" viewBox="0 0 300 18" aria-hidden="true"><path pathLength="1" d="M4 12 C70 4 150 2 296 9 M60 15 C130 11 200 11 250 13" /></svg></span>
  </PageHero>

  <!-- Bande de mots qui défile (décorative : les mêmes mots se répètent pour une boucle sans à-coup) -->
  <div class="mots" aria-hidden="true">
    <div class="mots-piste">
      <span>Foi<i aria-hidden="true">✦</i></span>
      <span>Créativité<i aria-hidden="true">✦</i></span>
      <span>Guérison intérieure<i aria-hidden="true">✦</i></span>
      <span>Prière<i aria-hidden="true">✦</i></span>
      <span>Espérance<i aria-hidden="true">✦</i></span>
      <span>Guérie et Épanouie<i aria-hidden="true">✦</i></span>
      <span>Devenu une légende<i aria-hidden="true">✦</i></span>
      <span>RED Éditions<i aria-hidden="true">✦</i></span>
      <span>Foi<i aria-hidden="true">✦</i></span>
      <span>Créativité<i aria-hidden="true">✦</i></span>
      <span>Guérison intérieure<i aria-hidden="true">✦</i></span>
      <span>Prière<i aria-hidden="true">✦</i></span>
      <span>Espérance<i aria-hidden="true">✦</i></span>
      <span>Guérie et Épanouie<i aria-hidden="true">✦</i></span>
      <span>Devenu une légende<i aria-hidden="true">✦</i></span>
      <span>RED Éditions<i aria-hidden="true">✦</i></span>
    </div>
  </div>

  <!-- Publications -->
  <section class="wrap sec pubs">
    <div class="sec-head">
      <div class="stack gap14">
        <span class="kicker">Publications</span>
        <h2 class="h2" style="--h2-d:47px;--h2-vw:3.24vw">Des mots pour t'accompagner</h2>
      </div>
      <a class="link only-desktop" href="/publications">Toutes les publications <Icon name="arrow-right" /></a>
    </div>
    <PubCards />
    <span class="small only-mobile">Publié par RED Éditions</span>
    <Rameau class="pubs-rameau" />
  </section>

  <!-- Trois portes -->
  <section class="wrap sec bg-pale portes">
    <div class="stack gap14 portes-head">
      <span class="kicker vert">Par où commencer&nbsp;?</span>
      <h2 class="h2" style="--h2-d:47px;--h2-vw:3.24vw">Trois portes, un même chemin</h2>
    </div>
    <div class="portes-grid">
      {portes.map((p) => (
        <a class="porte" href={p.href}>
          <span class="porte-icon"><Icon name={p.icon} /></span>
          <span class="porte-body">
            <span class="porte-titre">{p.titre}</span>
            <span class="porte-texte only-desktop">{p.texte}</span>
            <span class="porte-texte only-mobile">{p.court}</span>
            <span class="link only-desktop">Entrer <Icon name="arrow-right" /></span>
          </span>
          <Icon name="caret-right" class="porte-caret only-mobile" size={20} />
        </a>
      ))}
    </div>
  </section>

  <QuoteBand texte="Tu deviendras aussi une légende. Alors, s'il te plaît, n'abandonne pas." source="Race Élue · Devenu une légende, N°01" sourceMobile="Devenu une légende, N°01" pad="sec-2" />

  <!-- Mon histoire -->
  <section class="wrap sec histoire">
    <div class="histoire-photo">
      <Photo src="stage.jpg" alt="Race Élue au pupitre, micro en main, souriante, lors d'un culte" position="40% center" sizes="(min-width: 960px) 540px, 100vw" />
    </div>
    <div class="stack histoire-txt">
      <span class="kicker">Mon histoire</span>
      <h2 class="h2">Un appel reçu en 2024</h2>
      <p class="only-desktop">Dieu a déposé dans mon cœur le fardeau de parler des blessures intérieures. Je ne prétends pas être totalement guérie de tout ; je partage ce que j'ai vécu, chaque fois que Dieu a guéri mon cœur.</p>
      <p class="only-mobile">Dieu a déposé dans mon cœur le fardeau de parler des blessures intérieures. Je partage ce que j'ai vécu.</p>
      <div class="row-btns">
        <a class="btn btn-outline" href="/a-propos">Lire mon histoire</a>
        <a class="link only-desktop" href="/contact?onglet=invitation">M'inviter à intervenir</a>
      </div>
    </div>
  </section>

  <!-- Témoignages -->
  {temoignages.length > 0 && (
  <section class="sec bg-sable temoignages">
    <div class="wrap stack gap14">
      <span class="kicker only-desktop">Témoignages</span>
      <h2 class="h2">Elles ont trouvé de l'espoir</h2>
    </div>
    <div class="t-track wrap" data-carousel tabindex="0" aria-label="Témoignages, faire défiler horizontalement">
      {temoignages.map((t, i) => <TestimonialCard t={t} short={i > 0} />)}
    </div>
    <div class="dots only-mobile wrap" aria-hidden="true" data-dots>
      {temoignages.map((_, i) => <span class:list={{ on: i === 0 }}></span>)}
    </div>
    <div class="wrap t-foot">
      <a class="link" href="/temoignages">Tous les témoignages <Icon name="arrow-right" /></a>
    </div>
  </section>
  )}

  <!-- Ministère -->
  <section class:list={['wrap sec ministere', { 'bg-sable': temoignages.length === 0 }]}>
    <div class="stack ministere-txt">
      <span class="kicker vert">Le ministère</span>
      <h2 class="h2" style="--h2-d:50px;--h2-m:31px;--h2-vw:3.51vw">Guérie <em>et</em> Épanouie</h2>
      <p class="only-desktop">Une communauté de femmes qui avancent ensemble vers la guérison intérieure : partages, prière, enseignements et beaucoup de douceur. Tu peux y venir comme tu es.</p>
      <p class="only-mobile">Une communauté de femmes qui avancent ensemble vers la guérison. Viens comme tu es.</p>
      <div class="row-btns">
        <a class="btn btn-primary btn-md" href={wa(MSG.communaute)} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp-logo" />Rejoindre la communauté</a>
        <a class="link only-desktop" href="/guerie-et-epanouie">Découvrir le ministère</a>
      </div>
    </div>
    <div class="ministere-photo">
      <div class="arche-fond" aria-hidden="true"></div>
      <Photo src="grass.jpg" alt="Race Élue assise dans l'herbe, souriante, regardant au loin" position="center 60%" sizes="(min-width: 960px) 340px, 100vw" class="arche-img" />
    </div>
  </section>

  <NewsletterBand texteMobile="Et l'ebook offert dès ton inscription." />

  <!-- Réseaux -->
  <section class="wrap reseaux only-desktop" aria-labelledby="reseaux-titre">
    <h2 id="reseaux-titre" class="h2" style="--h2-d:36px">Retrouve-moi au quotidien</h2>
    <div class="reseaux-grid">
      {RESEAUX.map((r) => (
        <a class="reseau" href={r.url} target="_blank" rel="noopener noreferrer">
          <Icon name={r.icon} size={32} />
          <span class="stack"><strong>{r.nom}</strong><span>{r.pseudo}</span></span>
          <Icon name="arrow-up-right" size={20} class="out" />
        </a>
      ))}
    </div>
  </section>
</Base>

<script>
  // Points du carrousel de témoignages (mobile)
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((track) => {
    const dots = track.parentElement?.querySelectorAll<HTMLElement>('[data-dots] span');
    if (!dots?.length) return;
    track.addEventListener('scroll', () => {
      const cards = Array.from(track.children) as HTMLElement[];
      const left = track.scrollLeft;
      let idx = 0;
      cards.forEach((c, i) => { if (Math.abs(c.offsetLeft - track.offsetLeft - left) < Math.abs(cards[idx].offsetLeft - track.offsetLeft - left)) idx = i; });
      dots.forEach((d, i) => d.classList.toggle('on', i === idx));
    }, { passive: true });
  });
</script>

<style>
  .gap14 { gap: 14px; }
  .pubs :global(.pubs-rameau) { margin-top: 16px; }
  @media (min-width: 960px) { .pubs :global(.pubs-rameau) { margin-top: 8px; } }

  /* Héros (texte posé sur la photo) */
  .home-h1 { --h1-m: 38px; line-height: 1.02; max-width: 640px; }
  .btns { display: flex; flex-direction: column; gap: 12px; }
  .btns .btn { min-height: 52px; }
  .signature { font: italic 500 22px var(--serif); color: var(--or); margin-top: 8px; display: inline-block; align-self: flex-start; }
  .ministere-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 999px 999px 6px 6px; }
  @media (min-width: 960px) {
    .btns { flex-direction: row; gap: 16px; }
    .btns .btn { min-height: 56px; }
  }

  /* En-têtes de section */
  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .pubs { display: flex; flex-direction: column; gap: 24px; }
  @media (min-width: 960px) { .pubs { gap: 56px; } }

  /* Trois portes */
  .portes { display: flex; flex-direction: column; gap: 20px; }
  .portes-grid { display: flex; flex-direction: column; gap: 20px; }
  .porte {
    display: flex; align-items: center; gap: 16px; background: var(--creme); color: var(--encre);
    border-radius: 999px 12px 12px 999px; padding: 14px 18px 14px 14px; min-height: 72px;
    transition: transform 0.18s ease-out, box-shadow 0.18s ease-out;
  }
  .porte:hover { color: var(--encre); box-shadow: var(--ombre-md); }
  .porte-icon { width: 52px; height: 52px; flex: none; border-radius: 999px; background: var(--vert-pale); display: flex; align-items: center; justify-content: center; color: var(--cuivre); font-size: 22px; }
  .porte-body { display: flex; flex-direction: column; gap: 2px; }
  .porte-titre { font: 500 22px/1 var(--serif); color: var(--cacao); }
  .porte-texte { font-size: 13px; line-height: 1.4; }
  .porte :global(.porte-caret) { margin-left: auto; color: var(--cuivre); }
  @media (min-width: 960px) {
    .portes { align-items: center; gap: 56px; }
    .portes-head { align-items: center; text-align: center; }
    .portes-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; width: 100%; }
    .porte { flex-direction: column; border-radius: 999px 999px 12px 12px; padding: 72px 36px 40px; text-align: center; gap: 16px; }
    .porte:hover { transform: translateY(-4px); }
    .porte-icon { width: auto; height: auto; background: none; font-size: 29px; }
    .porte-body { align-items: center; gap: 16px; }
    .porte-titre { font-size: 34px; }
    .porte-texte { font-size: 14px; line-height: 1.6; }
  }

  /* Mon histoire */
  .histoire { display: flex; flex-direction: column; gap: 20px; }
  .histoire-photo { height: 300px; border-radius: var(--r-carte); overflow: hidden; }
  .histoire-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .histoire-txt { gap: 20px; }
  .histoire-txt p, .ministere-txt p { font-size: 14px; line-height: 1.65; }
  .row-btns { display: flex; flex-direction: column; gap: 16px; }
  .row-btns .btn { min-height: 52px; }
  @media (min-width: 960px) {
    .histoire { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 96px; align-items: center; }
    .histoire-photo { height: 440px; }
    .histoire-txt { gap: 22px; }
    .histoire-txt p, .ministere-txt p { font-size: 16px; line-height: 1.7; }
    .row-btns { flex-direction: row; align-items: center; }
    .row-btns .btn { min-height: 48px; font-size: 14px; padding: 0 22px; }
  }

  /* Témoignages : carrousel horizontal sur mobile, grille sur desktop */
  .temoignages { display: flex; flex-direction: column; gap: 20px; }
  .t-track {
    display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    padding-right: 20px; scroll-padding-left: var(--gutter);
  }
  .t-track::-webkit-scrollbar { display: none; }
  .t-track > :global(*) { flex: none; width: min(290px, 78vw); scroll-snap-align: start; }
  .dots { display: flex; gap: 6px; align-items: center; }
  .dots span { width: 6px; height: 6px; border-radius: 3px; background: var(--bordure); transition: width 0.18s ease-out, background-color 0.18s; }
  .dots span.on { width: 20px; background: var(--cuivre); }
  .t-foot { display: flex; flex-direction: column; gap: 4px; }
  @media (min-width: 960px) {
    .temoignages { gap: 48px; }
    .t-track { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; overflow: visible; padding-right: var(--gutter); }
    .t-track > :global(*) { width: auto; }
    .t-foot { flex-direction: row; justify-content: space-between; align-items: center; margin-top: -24px; }
  }

  /* Ministère */
  .ministere { display: flex; flex-direction: column-reverse; gap: 20px; }
  .ministere-txt { gap: 20px; }
  .ministere-photo { position: relative; height: 280px; }
  .arche-fond { display: none; }
  @media (min-width: 960px) {
    .ministere { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 96px; align-items: center; }
    .ministere-txt { gap: 22px; }
    .ministere-photo { height: 520px; max-width: 384px; width: 100%; justify-self: center; }
    .arche-fond { display: block; position: absolute; right: 0; top: 0; width: 360px; height: 480px; border-radius: var(--arche); background: var(--vert-pale); }
    .ministere-photo :global(img) { inset: auto auto 0 0; width: 340px; height: 460px; border-radius: var(--arche); }
  }
  @media (min-width: 960px) and (max-width: 1199.98px) {
    .arche-fond { width: 300px; height: 420px; }
    .ministere-photo { height: 460px; }
    .ministere-photo :global(img) { width: 290px; height: 400px; }
  }

  /* Réseaux */
  .reseaux { padding-bottom: var(--sec); display: flex; flex-direction: column; gap: 32px; }
  .reseaux-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .reseau {
    display: flex; gap: 16px; align-items: center; padding: 24px; border-radius: var(--r-carte);
    box-shadow: inset 0 0 0 1px var(--filet); color: var(--vert); transition: background-color 0.18s;
  }
  .reseau:hover { background: var(--sable); color: var(--vert); }
  .reseau strong { font: 700 14px var(--sans); color: var(--encre); }
  .reseau .stack span { font-size: 13px; color: var(--secondaire); }
  .reseau :global(.out) { margin-left: auto; color: var(--cuivre); }
</style>
