---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import BackLink from '../components/BackLink.astro';
import { EBOOK, wa, MSG } from '../data/site';
---
<Base title="Merci" description="Ton ebook « Comment Dieu guérit les cœurs brisés » est prêt." active="/merci" noindex bodyClass="sans-bandeau">
  <BackLink />
  <section class="wrap merci">
    <div class="txt">
      <span class="pastille"><Icon name="envelope-simple-open" /></span>
      <span class="kicker">Confirmation</span>
      <h1 class="h1" style="--h1-d:58px;--h1-m:36px;--h1-vw:3.96vw"><span data-merci>Merci</span>, <em data-titre-fin>l'ebook est en route.</em></h1>
      <p class="lead" data-texte>Regarde ta boîte mail dans quelques minutes. Si tu ne le vois pas, pense à vérifier les dossiers « Promotions » ou « Spam ».</p>
      <div class="btns">
        <a class="btn btn-primary btn-md" href={EBOOK.pdf} download><Icon name="download-simple" size={20} />Télécharger maintenant</a>
        <a class="btn btn-outline btn-md" href={wa(MSG.communaute)} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp-logo" size={20} />Rejoindre la communauté</a>
      </div>
    </div>
    <div class="photo only-desktop"><Photo src="studio-smile.jpg" alt="Race Élue souriante" position="center 40%" sizes="400px" /></div>
  </section>
</Base>

<script>
  const params = new URL(location.href).searchParams;
  const prenom = (params.get('prenom') || '').trim().slice(0, 40);
  if (prenom) document.querySelector('[data-merci]')!.textContent = `Merci ${prenom}`;
  // Sans service d'e-mail branché, l'ebook est proposé directement en téléchargement.
  if (params.get('direct') === '1') {
    document.querySelector('[data-titre-fin]')!.textContent = "ton ebook est prêt.";
    document.querySelector('[data-texte]')!.textContent = "Tu peux le télécharger tout de suite et le lire à ton rythme, même hors connexion une fois enregistré.";
  }
</script>

<style>
  .merci { padding-top: 48px; padding-bottom: 72px; min-height: 60vh; }
  .txt { display: flex; flex-direction: column; gap: 18px; max-width: 620px; }
  .pastille { width: 64px; height: 64px; border-radius: 999px; background: var(--vert-pale); display: flex; align-items: center; justify-content: center; color: var(--vert); font-size: 29px; }
  .btns { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .photo { height: 500px; border-radius: var(--arche); overflow: hidden; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 960px) {
    .merci { padding-top: 96px; padding-bottom: var(--sec-2); display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: clamp(48px, 6.6vw, 96px); align-items: center; }
    .txt { gap: 22px; }
    .pastille { width: 72px; height: 72px; font-size: 32px; }
    .btns { flex-direction: row; gap: 16px; }
  }
</style>
