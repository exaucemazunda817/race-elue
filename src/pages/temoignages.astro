---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import BackLink from '../components/BackLink.astro';
import { PUBLIES } from '../data/temoignages';
import { wa, MSG } from '../data/site';

// Variation des cartes comme dans la maquette : 1re en arche verte, 4e sur vert pâle, les autres sur sable.
const tone = (i: number) => (i === 0 ? 'arche' : i === 3 ? 'pale' : 'sable') as 'arche' | 'pale' | 'sable';
import PageHero from '../components/PageHero.astro';
import { HERO } from '../data/hero';
---
<Base
  title="Témoignages"
  description="Ce que Dieu a fait dans leur cœur : témoignages de lectrices et de membres de la communauté Guérie et Épanouie, publiés avec leur accord."
  active="/temoignages"
>
  <PageHero photos={HERO.temoignages} align="centre">
    <span class="kicker or">Témoignages</span>
    <h1 class="h1">Ce que Dieu a fait <em>dans leur cœur</em></h1>
    <p class="lead only-desktop">Chaque témoignage est publié avec l'accord de la personne. Les prénoms peuvent être abrégés pour protéger son intimité.</p>
    <p class="lead only-mobile">Publiés avec l'accord de chaque personne.</p>
  </PageHero>

  <BackLink />
  <section class="wrap mur-sec">
    {PUBLIES.length === 0 ? (
      <p class="vide">Les premiers témoignages seront publiés ici, chacun avec l'accord de la personne qui l'a confié.</p>
    ) : (
    <div class="mur">
      {PUBLIES.map((t, i) => (
        <div class:list={['brique', { 'mobile-hide': i >= 3 }]}>
          <TestimonialCard t={t} tone={tone(i)} showSource short />
        </div>
      ))}
    </div>
    )}
  </section>

  <section class="wrap partage-sec">
    <div class="partage">
      <div class="stack txt">
        <h2>Toi aussi, <em><span class="only-desktop">tu as une histoire à partager ?</span><span class="only-mobile">tu as une histoire ?</span></em></h2>
        <p class="only-desktop">Envoie-moi ton témoignage par écrit ou en message vocal. Je te demanderai ton accord avant toute publication.</p>
        <p class="only-mobile">Envoie-la par écrit ou en vocal. Rien n'est publié sans ton accord.</p>
      </div>
      <div class="btns">
        <a class="btn btn-wa btn-lg only-desktop" href={wa(MSG.temoignage)} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp-logo" />Par WhatsApp</a>
        <a class="btn btn-outline btn-lg only-desktop" href="/contact">Par écrit</a>
        <a class="btn btn-light btn-md only-mobile" href={wa(MSG.temoignage)} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp-logo" />Envoyer mon témoignage</a>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (min-width: 960px) {
  }
  .mur-sec { padding-top: 36px; padding-bottom: 36px; }
  .vide { font: italic 500 20px/1.4 var(--serif); color: var(--cacao); text-align: center; margin-inline: auto; max-width: 22em; }
  @media (min-width: 960px) { .vide { font-size: 25px; } }
  .mur { display: flex; flex-direction: column; gap: 16px; }
  .small { margin-top: 16px; }
  @media (max-width: 959.98px) {
    .mobile-hide { display: none; }
    .mur :global(.arche) { border-radius: var(--r-carte); padding: 24px; background: var(--sable); }
    .mur :global(.arche) :global(blockquote p) { color: var(--encre); font-size: 19px; }
    .mur :global(.arche) :global(figcaption) { color: var(--encre); }
    .mur :global(.arche) :global(.qmark) { color: var(--cuivre); }
  }
  @media (min-width: 960px) {
    .mur-sec { padding-top: 64px; padding-bottom: 40px; }
    .mur { display: block; column-count: 3; column-gap: 28px; }
    .brique { break-inside: avoid; margin: 0 0 28px; }
    .small { margin-top: 0; }
  }

  .partage-sec { padding-top: 0; padding-bottom: 48px; }
  .partage { background: var(--vert); border-radius: var(--r-bandeau); padding: 28px 22px; display: flex; flex-direction: column; gap: 14px; }
  .partage h2 { font-size: 25px; line-height: 1.1; color: var(--creme); }
  .partage h2 em { color: var(--or); }
  .partage p { font-size: 14px; line-height: 1.55; color: var(--texte-vert); }
  .txt { gap: 12px; }
  .btns { display: flex; gap: 12px; }
  .btns .btn { flex: 1; }
  @media (min-width: 960px) {
    .partage-sec { padding-top: 56px; padding-bottom: var(--sec-2); }
    .partage { background: var(--vert-pale); padding: 56px 64px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 56px; align-items: center; }
    .partage h2 { font-size: 38px; line-height: 1.08; color: var(--cacao); }
    .partage h2 em { color: inherit; }
    .partage p { font-size: 15px; line-height: 1.6; color: var(--encre); }
    .btns .btn { flex: none; }
  }
</style>
