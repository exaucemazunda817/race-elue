---
// Barre d'action collante, sur mobile uniquement (maquettes : ebook, À propos, Guérie, article).
import Icon from './Icon.astro';
import { wa } from '../data/site';

interface Props {
  withWhatsApp?: boolean;
  waMessage?: string;
}
const { withWhatsApp = true, waMessage } = Astro.props;
---
<div class="sticky-bar only-mobile">
  <slot />
  {withWhatsApp && (
    <a class="wa-round" href={wa(waMessage)} target="_blank" rel="noopener noreferrer" aria-label="M'écrire sur WhatsApp">
      <Icon name="whatsapp-logo" size={28} />
    </a>
  )}
</div>

<style>
  .sticky-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    background: var(--creme); box-shadow: 0 -8px 24px rgba(74, 42, 26, 0.12);
    padding: 12px 16px calc(16px + env(safe-area-inset-bottom));
    display: flex; gap: 10px; align-items: center;
  }
  .sticky-bar > :global(.btn) { flex: 1; min-height: 52px; }
  .wa-round {
    width: 52px; height: 52px; flex: none; border-radius: 999px; background: var(--whatsapp); color: #fff;
    display: flex; align-items: center; justify-content: center;
  }
  .wa-round:hover { color: #fff; background: #18663a; }
</style>
