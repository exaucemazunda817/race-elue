---
// Bandeau photo des pages, sur le modèle des bandeaux de One Love (demande de Mazunda du 10/10/2026) :
// la photo couvre tout le bandeau, un simple dégradé vert assombrit le côté du texte, rien d'autre
// (plus de panneau flou : il cachait les visages).
// - Ordinateur : photos PAYSAGE (les seules qui remplissent un écran large sans être trop agrandies).
// - Téléphone : photos PORTRAIT de la page (elles remplissent l'écran à leur taille réelle, donc nettes).
//   Même principe que One Love (version panoramique pour l'ordinateur, version verticale pour le téléphone).
// - Les photos se succèdent en fondu avec un zoom lent ; 1re photo chargée tout de suite, les suivantes après
//   le chargement de la page, jamais en économie de données. Bouton pause (WCAG 2.2.2).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { PAYSAGES } from '../data/hero';
import { urlImage } from '../lib/sanity';

const all = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });

// `url` : photo venue de Sanity (articles du blog) ; sinon `src` = fichier de src/assets/photos.
export type HeroPhoto = { src: string; alt: string; pos?: string; posMobile?: string; url?: string; w?: number; h?: number };
interface Props {
  photos: HeroPhoto[]; // photos du téléphone (portraits de la page)
  paysages?: HeroPhoto[]; // photos de l'ordinateur (paysage) ; par défaut les photos paysage du site
  size?: 'accueil' | 'page';
  align?: 'gauche' | 'centre';
  id?: string;
  chevauchement?: boolean; // le contenu suivant remonte sur le bas du bandeau (cartes de Contact)
  cote?: 'gauche' | 'droite'; // côté du texte sur ordinateur (droite : les visages sont à gauche des photos)
}
const { photos, paysages, size = 'page', align = 'gauche', id, chevauchement = false, cote = 'droite' } = Astro.props;
const img = (src: string) => {
  const m = all[`../assets/photos/${src}`];
  if (!m) throw new Error(`Photo introuvable : ${src}`);
  return m.default;
};
const widths = (src: string) => {
  const w = img(src).width;
  return [480, 800, 1200, 1600].filter((x) => x < w).concat(w);
};
const srcset = async (src: string, p?: HeroPhoto) => {
  if (p?.url) {
    const ws = [480, 800, 1200, 1600].filter((w) => !p.w || w < p.w).concat(p.w && p.w < 1600 ? [p.w] : []);
    return { set: ws.map((w) => `${urlImage(p.url!, w)} ${w}w`).join(', '), src: urlImage(p.url, 1200) };
  }
  const ws = widths(src);
  const out = await Promise.all(ws.map((w) => getImage({ src: img(src), width: w, format: 'webp', quality: 74 })));
  return { set: out.map((r, i) => `${r.src} ${ws[i]}w`).join(', '), src: out[out.length - 1].src };
};
// Les pages ne commencent pas toutes par la même photo d'ordinateur.
const decalage = Astro.url.pathname.length % 2;
const desk = paysages ?? [...PAYSAGES.slice(decalage), ...PAYSAGES.slice(0, decalage)];
const n = Math.max(photos.length, desk.length);
const slides = await Promise.all(Array.from({ length: n }, async (_, i) => {
  const m = photos[i % photos.length];
  const d = desk[i % desk.length];
  const [ms, ds] = await Promise.all([srcset(m.src, m), srcset(d.src, d)]);
  return {
    mob: ms, desk: ds, w: m.url ? m.w : img(m.src).width, h: m.url ? m.h : img(m.src).height,
    style: `--pos-m:${m.posMobile ?? m.pos ?? 'center'};--pos:${d.pos ?? 'center'}`,
  };
}));
const [premiere, ...suivantes] = slides;
const alts = [...new Set([...photos, ...desk].map((p) => p.alt))];
// Étoiles ✦ qui scintillent dans le bandeau (positions fixes : même rendu à chaque visite).
const ETOILES = [
  { x: 62, y: 18, t: 14, d: 0 }, { x: 78, y: 30, t: 10, d: 1.2 }, { x: 90, y: 14, t: 18, d: 2.1 },
  { x: 70, y: 62, t: 11, d: 0.6 }, { x: 86, y: 74, t: 15, d: 2.8 }, { x: 54, y: 82, t: 9, d: 1.7 }, { x: 95, y: 48, t: 12, d: 3.4 },
];
---
<section class:list={['page-hero on-vert', `ph-${size}`, `ph-${align}`, `ph-cote-${cote}`, { 'ph-chevauche': chevauchement }]} id={id} data-hero-photos={n}>
  <div class="ph-slides" aria-hidden="true">
    <div class="ph-slide is-on"><div class="ph-photo">
      <picture>
        <source media="(min-width: 960px)" srcset={premiere.desk.set} sizes="100vw" type="image/webp" />
        <img src={premiere.mob.src} srcset={premiere.mob.set} sizes="100vw" alt="" width={premiere.w} height={premiere.h}
          loading="eager" fetchpriority="high" decoding="async" style={premiere.style} />
      </picture>
    </div></div>
    {suivantes.map((sl) => (
      <template data-slide>
        <div class="ph-slide"><div class="ph-photo">
          <picture>
            <source media="(min-width: 960px)" srcset={sl.desk.set} sizes="100vw" type="image/webp" />
            <img src={sl.mob.src} srcset={sl.mob.set} sizes="100vw" alt="" width={sl.w} height={sl.h} loading="lazy" decoding="async" style={sl.style} />
          </picture>
        </div></div>
      </template>
    ))}
  </div>
  <div class="ph-scrim" aria-hidden="true"></div>
  <div class="ph-stars" aria-hidden="true">
    {ETOILES.map((e) => <span style={`--x:${e.x}%;--y:${e.y}%;--t:${e.t}px;--d:${e.d}s`}>✦</span>)}
  </div>
  <p class="sr-only">{alts.join(' · ')}</p>
  <div class="ph-inner wrap">
    <div class="hero-txt ph-txt">
      <slot />
    </div>
  </div>
  {n > 1 && (
    <button type="button" class="ph-pause" data-pause aria-pressed="false" aria-label="Mettre en pause le défilement des photos" hidden>
      <Icon name="pause" class="i-pause" size={18} /><Icon name="play" class="i-play" size={18} />
    </button>
  )}
</section>

<script>
  const EVERY = 6500;
  document.querySelectorAll<HTMLElement>('[data-hero-photos]').forEach((hero) => {
    const box = hero.querySelector<HTMLElement>('.ph-slides')!;
    const templates = Array.from(box.querySelectorAll<HTMLTemplateElement>('template[data-slide]'));
    const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-pause]');
    if (!templates.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (document.documentElement.classList.contains('save-data')) return;

    let slides: HTMLElement[] = [];
    let current = 0;
    let paused = false;
    let visible = true;
    let timer = 0;
    const order: number[] = [];

    // Tirage au hasard sans remise : chaque photo passe une fois avant qu'une autre ne revienne.
    const next = () => {
      if (!order.length) {
        const rest = slides.map((_, i) => i).filter((i) => i !== current);
        for (let i = rest.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [rest[i], rest[j]] = [rest[j], rest[i]]; }
        order.push(...rest);
      }
      return order.shift()!;
    };
    const tick = () => {
      if (paused || !visible || document.hidden) return;
      const n = next();
      const img = slides[n].querySelector('img');
      const go = () => {
        slides[current].classList.remove('is-on');
        slides[n].classList.add('is-on');
        current = n;
      };
      // On n'affiche la photo suivante qu'une fois chargée (pas de fondu vers un vide en 3G).
      if (img && !img.complete) img.addEventListener('load', go, { once: true }); else go();
    };

    const start = () => {
      templates.forEach((t) => box.appendChild(t.content.firstElementChild!.cloneNode(true)));
      templates.forEach((t) => t.remove());
      slides = Array.from(box.querySelectorAll<HTMLElement>('.ph-slide'));
      timer = window.setInterval(tick, EVERY);
      if (pauseBtn) pauseBtn.hidden = false;
    };
    // Les photos suivantes ne se téléchargent qu'après le chargement complet de la page.
    if (document.readyState === 'complete') setTimeout(start, 1200);
    else addEventListener('load', () => setTimeout(start, 1200), { once: true });

    new IntersectionObserver((e) => { visible = !!e[0]?.isIntersecting; }, { threshold: 0.15 }).observe(hero);
    pauseBtn?.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.setAttribute('aria-label', paused ? 'Reprendre le défilement des photos' : 'Mettre en pause le défilement des photos');
      hero.classList.toggle('is-paused', paused);
    });
    addEventListener('pagehide', () => clearInterval(timer));
  });
</script>

<style>
  .page-hero { position: relative; isolation: isolate; overflow: hidden; background: var(--vert); color: var(--texte-vert); display: flex; }
  .ph-accueil { min-height: min(100vh, 880px); min-height: min(100svh, 880px); }
  .ph-page { min-height: min(80vh, 640px); min-height: min(80svh, 640px); }
  .ph-slides { position: absolute; inset: 0; z-index: -2; }
  .ph-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1400ms ease-in-out; }
  .ph-slide.is-on { opacity: 1; }
  .ph-photo { position: absolute; inset: 0; overflow: hidden; }
  .ph-slide :global(picture), .ph-slide :global(img) { display: block; width: 100%; height: 100%; }
  .ph-slide :global(img) { object-fit: cover; }
  .ph-photo :global(img) {
    object-position: var(--pos-m);
    animation: ph-kb 20s ease-in-out infinite alternate; will-change: transform;
  }
  @media (min-width: 960px) { .ph-photo :global(img) { object-position: var(--pos); animation-name: ph-kb-doux; } }
  .is-paused .ph-photo :global(img) { animation-play-state: paused; }
  @keyframes ph-kb { from { transform: scale(1.02); } to { transform: scale(1.1) translate3d(-1%, -1%, 0); } }
  @keyframes ph-kb-doux { from { transform: scale(1); } to { transform: scale(1.06) translate3d(-1%, -0.5%, 0); } }

  /* Dégradé, comme les bandeaux de One Love : léger en haut (sous l'en-tête), dense seulement du côté du
     texte ; aucun flou, la photo reste nette et les visages visibles. */
  .ph-scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(20, 40, 32, 0.4) 0%, rgba(20, 40, 32, 0) 16%),
      linear-gradient(180deg, rgba(30, 59, 47, 0) 34%, rgba(30, 59, 47, 0.55) 48%, rgba(30, 59, 47, 0.9) 62%, rgba(30, 59, 47, 0.94) 100%);
  }
  @media (min-width: 960px) {
    .ph-scrim {
      background:
        linear-gradient(180deg, rgba(20, 40, 32, 0.4) 0%, rgba(20, 40, 32, 0) 18%),
        linear-gradient(90deg, rgba(30, 59, 47, 0.94) 0%, rgba(30, 59, 47, 0.9) 42%, rgba(30, 59, 47, 0.4) 58%, rgba(30, 59, 47, 0) 76%);
    }
    .ph-cote-droite .ph-scrim {
      background:
        linear-gradient(180deg, rgba(20, 40, 32, 0.4) 0%, rgba(20, 40, 32, 0) 18%),
        linear-gradient(270deg, rgba(30, 59, 47, 0.94) 0%, rgba(30, 59, 47, 0.9) 42%, rgba(30, 59, 47, 0.4) 58%, rgba(30, 59, 47, 0) 76%);
    }
    .ph-cote-droite .ph-inner { justify-content: flex-end; }
    .ph-cote-droite .ph-txt { max-width: 460px; }
    .ph-cote-droite .ph-stars span { left: auto; right: var(--x); }
  }

  /* Étoiles ✦ */
  .ph-stars { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .ph-stars span {
    position: absolute; left: var(--x); top: var(--y); font-size: var(--t); line-height: 1; color: var(--or-couv);
    text-shadow: 0 0 12px rgba(226, 194, 122, 0.8); opacity: 0;
    animation: ph-star 4.8s ease-in-out var(--d) infinite;
  }
  @keyframes ph-star {
    0%, 100% { opacity: 0; transform: scale(0.4) rotate(0deg); }
    45% { opacity: 0.95; transform: scale(1) rotate(45deg); }
    70% { opacity: 0.4; transform: scale(0.8) rotate(70deg); }
  }
  @media (max-width: 959.98px) { .ph-stars span:nth-child(n + 5) { display: none; } .ph-stars span { top: calc(var(--y) * 0.5); } }

  .ph-inner { position: relative; width: 100%; display: flex; align-items: flex-end; padding-top: 140px; padding-bottom: 48px; }
  .ph-txt { position: relative; display: flex; flex-direction: column; gap: 18px; max-width: 640px; }
  .ph-txt :global(.lead) { color: var(--texte-vert); max-width: 32em; }
  /* Sur photo, l'or de la maquette (#C9A24B) manque de contraste : or clair, plus une ombre douce. */
  .ph-txt :global(.kicker.or), .ph-txt :global(.crumb a), .ph-txt :global(.signature) { color: var(--or-couv); }
  .ph-txt :global(.kicker), .ph-txt :global(.crumb), .ph-txt :global(.lead), .ph-txt :global(.byline) { text-shadow: 0 1px 12px rgba(20, 40, 32, 0.6); }
  .ph-txt :global(.crumb) { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; font: 600 13px var(--sans); color: var(--discret-vert); }
  .ph-txt :global(.crumb .back) { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; font-size: 12px; padding: 0 16px; border-radius: 999px; background: rgba(30, 59, 47, 0.92); box-shadow: inset 0 0 0 1px rgba(226, 194, 122, 0.45); }
  .ph-txt :global(h1) { text-shadow: 0 2px 24px rgba(0, 0, 0, 0.3); }
  /* Téléphone : le dégradé (sans flou) démarre juste au-dessus du texte, quelle que soit sa hauteur ;
     le visage, au-dessus, reste net. */
  @media (max-width: 959.98px) {
    .ph-txt { position: relative; }
    .ph-txt::before {
      content: ''; position: absolute; z-index: -1; pointer-events: none;
      left: calc(50% - 50vw); right: calc(50% - 50vw); top: -90px; bottom: -200px;
      background: linear-gradient(180deg, rgba(30, 59, 47, 0) 0, rgba(30, 59, 47, 0.82) 90px, rgba(30, 59, 47, 0.9) 100%);
    }
    .ph-centre .ph-inner { justify-content: center; text-align: center; }
    .ph-centre .ph-txt { align-items: center; margin-inline: auto; }
  }
  @media (min-width: 960px) {
    .ph-inner { align-items: center; padding-top: 140px; padding-bottom: 96px; }
    .ph-accueil .ph-inner { padding-bottom: 120px; }
    .ph-chevauche .ph-inner { padding-bottom: 200px; }
    .ph-txt { gap: 24px; max-width: 580px; }
  }

  /* Parallaxe au défilement (navigateurs récents ; ailleurs, la photo reste simplement fixe) */
  @supports (animation-timeline: scroll()) {
    .ph-slides { animation: ph-para linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
    .ph-inner { animation: ph-fuite linear both; animation-timeline: scroll(root); animation-range: 0 70vh; }
    @keyframes ph-para { to { transform: translate3d(0, 22%, 0); } }
    @keyframes ph-fuite { to { transform: translate3d(0, -56px, 0); } }
  }

  .ph-pause {
    position: absolute; right: var(--gutter); top: 88px; z-index: 2; width: 44px; height: 44px; border-radius: 999px;
    border: 1px solid rgba(251, 247, 241, 0.45); background: rgba(30, 59, 47, 0.55); color: var(--creme);
    display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(4px);
  }
  @media (min-width: 1100px) { .ph-pause { top: 104px; right: 48px; } }
  .ph-pause:hover { border-color: var(--or); color: var(--or-hover); }
  .ph-pause :global(.i-play) { display: none; }
  .ph-pause[aria-pressed='true'] :global(.i-play) { display: inline-block; }
  .ph-pause[aria-pressed='true'] :global(.i-pause) { display: none; }
  .is-paused .ph-stars span { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .ph-photo :global(img), .ph-stars span, .ph-slides, .ph-inner { animation: none !important; }
    .ph-stars { display: none; }
    .ph-slide { transition: none; }
  }
  :global(html.save-data) .ph-stars { display: none; }
</style>
