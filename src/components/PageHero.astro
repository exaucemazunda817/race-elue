---
// Bandeau photo pleine largeur, d'un bord à l'autre (demande de Mazunda du 10/10/2026, « comme One Love »),
// avec un site vivant : les photos se succèdent en fondu, chacune avec un zoom lent.
// - 1re photo chargée tout de suite (c'est elle que le visiteur voit en premier) ; les suivantes sont
//   ajoutées après le chargement de la page, jamais en économie de données (3G : on ne télécharge pas
//   ce que personne n'a encore demandé).
// - Bouton pause obligatoire (WCAG 2.2.2 : tout mouvement automatique de plus de 5 s doit pouvoir s'arrêter).
// - Rotation arrêtée si l'onglet est masqué ou le bandeau hors écran ; aucune si « Réduire les animations ».
// - Voile vert dense du côté du texte (lisibilité mesurée), plus léger du côté de la photo.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

const all = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });

export type HeroPhoto = { src: string; alt: string; pos?: string; posMobile?: string };
interface Props {
  photos: HeroPhoto[];
  size?: 'accueil' | 'page';
  align?: 'gauche' | 'centre';
  id?: string;
  chevauchement?: boolean; // le contenu suivant remonte sur le bas du bandeau (cartes de Contact)
}
const { photos, size = 'page', align = 'gauche', id, chevauchement = false } = Astro.props;
const img = (src: string) => {
  const m = all[`../assets/photos/${src}`];
  if (!m) throw new Error(`Photo introuvable : ${src}`);
  return m.default;
};
const widths = (src: string) => {
  const w = img(src).width;
  return [480, 800, 1200, 1600].filter((x) => x < w).concat(w);
};
const [premiere, ...suivantes] = photos;
// Sur ordinateur la photo nette occupe ~56 % de la largeur : on ne télécharge pas plus grand que nécessaire.
const SIZES = '(min-width: 960px) 56vw, 100vw';
---
<section class:list={['page-hero on-vert', `ph-${size}`, `ph-${align}`, { 'ph-chevauche': chevauchement }]} id={id} data-hero-photos={photos.length}>
  <div class="ph-slides" aria-hidden="true">
    <div class="ph-slide is-on">
      <div class="ph-fond"><Picture src={img(premiere.src)} alt="" widths={widths(premiere.src)} sizes={SIZES} formats={['webp']} fallbackFormat="jpg" quality={74} loading="eager" /></div>
      <div class="ph-photo"><Picture
        src={img(premiere.src)} alt="" widths={widths(premiere.src)} sizes={SIZES} formats={['webp']} fallbackFormat="jpg"
        quality={74} loading="eager" fetchpriority="high"
        style={`--pos:${premiere.pos ?? 'center'};--pos-m:${premiere.posMobile ?? premiere.pos ?? 'center'}`}
      /></div>
    </div>
    {suivantes.map((p) => (
      <template data-slide>
        <div class="ph-slide">
          <div class="ph-fond"><Picture src={img(p.src)} alt="" widths={widths(p.src)} sizes={SIZES} formats={['webp']} fallbackFormat="jpg" quality={74} loading="lazy" /></div>
          <div class="ph-photo"><Picture
            src={img(p.src)} alt="" widths={widths(p.src)} sizes={SIZES} formats={['webp']} fallbackFormat="jpg"
            quality={74} loading="lazy"
            style={`--pos:${p.pos ?? 'center'};--pos-m:${p.posMobile ?? p.pos ?? 'center'}`}
          /></div>
        </div>
      </template>
    ))}
  </div>
  <div class="ph-scrim" aria-hidden="true"></div>
  <p class="sr-only">{photos.map((p) => p.alt).join(' · ')}</p>
  <div class="ph-inner wrap">
    <div class="hero-txt ph-txt">
      <slot />
    </div>
  </div>
  {photos.length > 1 && (
    <button type="button" class="ph-pause" data-pause aria-pressed="false" aria-label="Mettre en pause le défilement des photos" hidden>
      <Icon name="pause" class="i-pause" size={18} /><Icon name="play" class="i-play" size={18} />
    </button>
  )}
</section>

<script>
  const EVERY = 6500;
  document.querySelectorAll<HTMLElement>('[data-hero-photos]').forEach((hero) => {
    const box = hero.querySelector<HTMLElement>('.ph-slides')!;
    const templates = Array.from(box.querySelectorAll<HTMLTemplateElement>('template[data-slide]'));
    const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-pause]');
    if (!templates.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (document.documentElement.classList.contains('save-data')) return;

    let slides: HTMLElement[] = [];
    let current = 0;
    let paused = false;
    let visible = true;
    let timer = 0;
    const order: number[] = [];

    // Tirage au hasard sans remise : chaque photo passe une fois avant qu'une autre ne revienne.
    const next = () => {
      if (!order.length) {
        const rest = slides.map((_, i) => i).filter((i) => i !== current);
        for (let i = rest.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [rest[i], rest[j]] = [rest[j], rest[i]]; }
        order.push(...rest);
      }
      return order.shift()!;
    };
    const tick = () => {
      if (paused || !visible || document.hidden) return;
      const n = next();
      const img = slides[n].querySelector('img');
      const go = () => {
        slides[current].classList.remove('is-on');
        slides[n].classList.add('is-on');
        current = n;
      };
      // On n'affiche la photo suivante qu'une fois chargée (pas de fondu vers un vide en 3G).
      if (img && !img.complete) img.addEventListener('load', go, { once: true }); else go();
    };

    const start = () => {
      templates.forEach((t) => box.appendChild(t.content.firstElementChild!.cloneNode(true)));
      templates.forEach((t) => t.remove());
      slides = Array.from(box.querySelectorAll<HTMLElement>('.ph-slide'));
      timer = window.setInterval(tick, EVERY);
      if (pauseBtn) pauseBtn.hidden = false;
    };
    // Les photos suivantes ne se téléchargent qu'après le chargement complet de la page.
    if (document.readyState === 'complete') setTimeout(start, 1200);
    else addEventListener('load', () => setTimeout(start, 1200), { once: true });

    new IntersectionObserver((e) => { visible = !!e[0]?.isIntersecting; }, { threshold: 0.15 }).observe(hero);
    pauseBtn?.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.setAttribute('aria-label', paused ? 'Reprendre le défilement des photos' : 'Mettre en pause le défilement des photos');
      hero.classList.toggle('is-paused', paused);
    });
    addEventListener('pagehide', () => clearInterval(timer));
  });
</script>

<style>
  .page-hero { position: relative; isolation: isolate; overflow: hidden; background: var(--vert); color: var(--texte-vert); display: flex; }
  .ph-accueil { min-height: min(92vh, 760px); min-height: min(92svh, 760px); }
  .ph-page { min-height: min(72vh, 560px); min-height: min(72svh, 560px); }
  .ph-slides { position: absolute; inset: 0; z-index: -2; }
  .ph-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1400ms ease-in-out; }
  .ph-slide.is-on { opacity: 1; }
  .ph-fond, .ph-photo { position: absolute; inset: 0; }
  .ph-slide :global(picture), .ph-slide :global(img) { display: block; width: 100%; height: 100%; }
  .ph-slide :global(img) { object-fit: cover; }
  .ph-fond { display: none; }
  .ph-photo :global(img) {
    object-position: var(--pos-m);
    animation: ph-kb 20s ease-in-out infinite alternate; will-change: transform;
  }
  /* Ordinateur : la photo floutée remplit toute la largeur ; la photo nette, à sa taille réelle,
     occupe la droite et se fond vers la gauche (pas d'agrandissement : pas de flou). */
  @media (min-width: 960px) {
    .ph-fond { display: block; overflow: hidden; }
    .ph-fond :global(img) { filter: blur(26px) saturate(1.15); transform: scale(1.2); opacity: 0.85; }
    .ph-photo { left: auto; width: 56%; overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 42%); mask-image: linear-gradient(90deg, transparent 0%, #000 42%); }
    .ph-photo :global(img) { object-position: var(--pos); }
  }
  .is-paused .ph-photo :global(img) { animation-play-state: paused; }
  @keyframes ph-kb { from { transform: scale(1.02); } to { transform: scale(1.12) translate3d(-1.5%, -1%, 0); } }

  /* Voile : en bas sur téléphone (le texte y est posé), à gauche sur ordinateur. */
  .ph-scrim {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(30, 59, 47, 0.2) 0%, rgba(30, 59, 47, 0.55) 18%, rgba(30, 59, 47, 0.9) 30%, rgba(30, 59, 47, 0.96) 46%, #1e3b2f 100%);
  }
  @media (max-width: 959.98px) {
    .ph-centre .ph-scrim { background: linear-gradient(180deg, rgba(30, 59, 47, 0.35) 0%, rgba(30, 59, 47, 0.6) 22%, rgba(30, 59, 47, 0.92) 38%, #1e3b2f 100%); }
  }
  @media (min-width: 960px) {
    .ph-scrim {
      background:
        linear-gradient(90deg, rgba(30, 59, 47, 0.96) 0%, rgba(30, 59, 47, 0.92) 48%, rgba(30, 59, 47, 0.5) 64%, rgba(30, 59, 47, 0.12) 80%, rgba(30, 59, 47, 0.04) 100%),
        linear-gradient(0deg, rgba(30, 59, 47, 0.55) 0%, rgba(30, 59, 47, 0) 30%);
    }
  }

  .ph-inner { position: relative; width: 100%; display: flex; align-items: flex-end; padding-top: 120px; padding-bottom: 48px; }
  .ph-txt { display: flex; flex-direction: column; gap: 18px; max-width: 640px; }
  .ph-txt :global(.lead) { color: var(--texte-vert); }
  /* Sur photo, l'or de la maquette (#C9A24B) manque de contraste : or clair, plus une ombre douce. */
  .ph-txt :global(.kicker.or), .ph-txt :global(.crumb a), .ph-txt :global(.signature) { color: var(--or-couv); }
  .ph-txt :global(.kicker), .ph-txt :global(.crumb), .ph-txt :global(.lead), .ph-txt :global(.byline) { text-shadow: 0 1px 12px rgba(20, 40, 32, 0.6); }
  .ph-txt :global(.crumb) { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; font: 600 14px var(--sans); color: var(--discret-vert); }
  .ph-txt :global(.crumb a) { color: var(--or); }
  .ph-txt :global(.crumb .back) { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; font-size: 13px; padding: 0 16px; border-radius: 999px; background: rgba(30, 59, 47, 0.92); box-shadow: inset 0 0 0 1px rgba(226, 194, 122, 0.45); }
  /* Texte centré sur téléphone seulement : sur ordinateur, la photo nette occupe la droite. */
  @media (max-width: 959.98px) {
    .ph-centre .ph-inner { justify-content: center; text-align: center; }
    .ph-centre .ph-txt { align-items: center; margin-inline: auto; }
  }
  @media (min-width: 960px) {
    .ph-inner { align-items: center; padding-top: 72px; padding-bottom: 88px; }
    .ph-accueil .ph-inner { padding-bottom: 112px; }
    .ph-chevauche .ph-inner { padding-bottom: 200px; }
    .ph-txt { gap: 24px; max-width: 580px; }
    .ph-txt :global(h1) { text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25); }
  }

  .ph-pause {
    position: absolute; right: var(--gutter); top: 20px; z-index: 2; width: 44px; height: 44px; border-radius: 999px;
    border: 1px solid rgba(251, 247, 241, 0.45); background: rgba(30, 59, 47, 0.55); color: var(--creme);
    display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(4px);
  }
  .ph-pause:hover { border-color: var(--or); color: var(--or-hover); }
  .ph-pause :global(.i-play) { display: none; }
  .ph-pause[aria-pressed='true'] :global(.i-play) { display: inline-block; }
  .ph-pause[aria-pressed='true'] :global(.i-pause) { display: none; }
  @media (max-width: 959.98px) { .ph-pause { top: 16px; } }

  @media (prefers-reduced-motion: reduce) {
    .ph-photo :global(img) { animation: none; }
    .ph-slide { transition: none; }
  }
</style>
