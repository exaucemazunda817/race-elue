---
// Couverture réelle d'une publication (page 1 du PDF), à la place des couvertures redessinées en CSS des maquettes.
import { Image } from 'astro:assets';
import ebook from '../assets/covers/ebook.png';
import magazine from '../assets/covers/magazine-n01.png';

interface Props {
  kind: 'ebook' | 'magazine';
  width: number; // largeur d'affichage en px (desktop)
  sizes?: string;
  priority?: boolean;
  shadow?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { kind, width, sizes, priority = false, shadow = 'md', class: className } = Astro.props;
const src = kind === 'ebook' ? ebook : magazine;
const alt = kind === 'ebook'
  ? 'Couverture de l\'ebook « Comment Dieu guérit les cœurs brisés » de Race Élue Disanka'
  : 'Couverture du magazine « Devenu une légende », N°01';
const widths = [Math.round(width), Math.round(width * 2)].filter((w) => w <= src.width);
---
<Image
  src={src}
  alt={alt}
  widths={widths.length ? widths : [src.width]}
  sizes={sizes ?? `${width}px`}
  format="webp"
  quality={78}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  class:list={['cover', `cover-${shadow}`, `cover-${kind}`, className]}
/>

<style>
  .cover { width: 100%; height: auto; aspect-ratio: 595 / 842; object-fit: cover; border-radius: 4px; background: #f9f2e8; }
  .cover-magazine { background: #141613; }
  .cover-sm { box-shadow: 0 10px 20px -8px rgba(74, 42, 26, 0.4); border-radius: 3px; }
  .cover-md { box-shadow: 0 18px 36px -10px rgba(74, 42, 26, 0.35); }
  .cover-magazine.cover-md { box-shadow: 0 18px 36px -10px rgba(0, 0, 0, 0.6); }
  .cover-lg { box-shadow: var(--ombre-couv), 0 2px 4px rgba(74, 42, 26, 0.12); }
  .cover-magazine.cover-lg { box-shadow: 0 40px 72px -20px rgba(0, 0, 0, 0.65); }
</style>
