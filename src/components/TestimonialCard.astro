---
import type { Temoignage } from '../data/temoignages';

interface Props {
  t: Temoignage;
  tone?: 'creme' | 'sable' | 'pale' | 'arche';
  size?: 'md' | 'lg';
  showSource?: boolean;
  short?: boolean;
}
const { t, tone = 'creme', size = 'md', showSource = false, short = false } = Astro.props;
const texte = short && t.court ? t.court : t.texte;
---
<figure class:list={['tcard', tone, size, { 'on-vert': tone === 'arche' }]}>
  <span class="qmark" aria-hidden="true">“</span>
  <blockquote><p>{texte}</p></blockquote>
  <figcaption>{t.auteur}{showSource && ` · ${t.source}`}</figcaption>
</figure>

<style>
  .tcard { border-radius: var(--r-carte); padding: 24px; display: flex; flex-direction: column; gap: 12px; margin: 0; }
  .creme { background: var(--creme); }
  .sable { background: var(--sable); }
  .pale { background: var(--vert-pale); }
  .arche { background: var(--vert); border-radius: 999px 999px 12px 12px; padding: 72px 36px 36px; }
  .qmark { font-size: 48px; padding-top: 14px; }
  blockquote { margin: 0; }
  blockquote p { font: italic 500 20px/1.35 var(--serif); color: var(--encre); }
  .arche blockquote p { color: var(--creme); font-size: 24px; line-height: 1.3; }
  figcaption { font: 600 14px var(--sans); color: var(--encre); }
  .arche figcaption { color: var(--texte-vert); }
  @media (min-width: 960px) {
    .tcard { padding: 32px; gap: 16px; }
    .qmark { font-size: 60px; padding-top: 18px; }
    blockquote p { font-size: 22px; }
    .lg { padding: 36px; }
    .lg blockquote p { font-size: 24px; }
    .arche { padding: 72px 36px 36px; }
    .arche blockquote p { font-size: 28px; }
  }
</style>
