---
// Photo optimisée : WebP, plusieurs largeurs (400/800/1200), chargement différé sauf héros.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });

import { urlImage } from '../lib/sanity';

interface Props {
  src?: string; // nom du fichier dans src/assets/photos
  url?: string; // ou photo venue de Sanity (redimensionnée par leur service d'images)
  w?: number;
  h?: number;
  alt: string;
  sizes?: string;
  position?: string;
  priority?: boolean;
  class?: string;
  style?: string;
}
const { src, url, w: wD, h: hD, alt, sizes = '(min-width: 960px) 50vw, 100vw', position = 'center', priority = false, class: className, style } = Astro.props;
const mod = url ? undefined : photos[`../assets/photos/${src}`];
if (!url && !mod) throw new Error(`Photo introuvable : ${src}`);
const img = mod?.default;
const widths = img ? [400, 800, 1200].filter((w) => w < img.width).concat(img.width) : [];
const distants = url ? [400, 800, 1200, 1600].filter((w) => !wD || w < wD).concat(wD && wD < 1600 ? [wD] : []) : [];
---
{url ? (
  <img
    src={urlImage(url, 1200)}
    srcset={distants.map((w) => `${urlImage(url, w)} ${w}w`).join(', ')}
    sizes={sizes}
    alt={alt}
    width={wD}
    height={hD}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
    class={className}
    style={`object-position:${position};${style ?? ''}`}
  />
) : img && <Picture
  src={img}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['webp']}
  fallbackFormat="jpg"
  quality={72}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  class={className}
  style={`object-position:${position};${style ?? ''}`}
/>
}
