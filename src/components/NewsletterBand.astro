---
import SubscribeForm from './SubscribeForm.astro';
import Photo from './Photo.astro';

interface Props {
  id?: string;
  titre?: string;
  titreEm?: string;
  texte?: string;
  texteMobile?: string;
  button?: string;
  source?: string;
  after?: 'merci' | 'message';
  pad?: 'sec' | 'sec-2';
  flushTop?: boolean;
  photo?: string; // photo de fond de la bande (10/10/2026), la carte reste posée dessus
  position?: string;
}
const {
  id = 'newsletter', titre = 'Une pensée chaque semaine,', titreEm = 'avec une prière',
  texte = "Et l'ebook offert dès ton inscription. Pas de spam, désinscription en un clic.",
  texteMobile, button = "Je m'inscris", source = 'newsletter', after = 'merci', pad = 'sec', flushTop = true,
  photo = 'laptop-talk.jpg', position = '50% 28%',
} = Astro.props;
---
<section class:list={['wrap nl-sec', pad]} id={id} aria-labelledby={`${id}-titre`}>
  <div class="nl-fond" aria-hidden="true"><Photo src={photo} alt="" sizes="100vw" position={position} /></div>
  <div class="nl">
    <div class="txt">
      <h2 id={`${id}-titre`}>{titre} <em>{titreEm}</em></h2>
      {texteMobile !== undefined ? (
        <>
          <p class="only-desktop">{texte}</p>
          {texteMobile && <p class="only-mobile">{texteMobile}</p>}
        </>
      ) : <p>{texte}</p>}
    </div>
    <SubscribeForm id={id} button={button} source={source} after={after} border="#B9C7B4" />
  </div>
</section>

<style>
  .nl-sec { position: relative; isolation: isolate; overflow: hidden; }
  .nl-fond { position: absolute; inset: 0; z-index: -1; }
  .nl-fond :global(picture), .nl-fond :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .nl-fond::after { content: ''; position: absolute; inset: 0; background: rgba(30, 59, 47, 0.78); }
  .nl {
    box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.5);
    background: var(--vert-pale); border-radius: var(--r-bandeau); padding: 28px 22px;
    display: flex; flex-direction: column; gap: 14px;
  }
  .txt { display: flex; flex-direction: column; gap: 12px; }
  h2 { font-size: 25px; line-height: 1.1; }
  p { font-size: 14px; line-height: 1.55; }
  @media (min-width: 960px) {
    .nl { padding: 56px 64px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
    h2 { font-size: 36px; line-height: 1.08; }
    p { font-size: 14px; line-height: 1.6; }
  }
</style>
