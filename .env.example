# Adresse publique du site (balises canoniques, aperçus de partage, sitemap). Type « Configuration » sur Vercel.
SITE_URL=https://race-elue.vercel.app
# Service d'inscription e-mail (Brevo, MailerLite, Formspree…). Vide = téléchargement direct de l'ebook.
PUBLIC_NEWSLETTER_ENDPOINT=
# Service de réception des messages de contact. Vide = message préparé dans WhatsApp.
PUBLIC_CONTACT_ENDPOINT=
# Blog (Sanity). Identifiant du projet : public, type « Configuration » sur Vercel. Vide = pensées écrites dans le code.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Seulement en local, pour le transfert des pensées (scripts/migrer-pensees-vers-sanity.ts) : jeton « Editor ».
# À supprimer dans sanity.io/manage une fois le transfert fait. Jamais sur Vercel, jamais dans une discussion.
SANITY_WRITE_TOKEN=
