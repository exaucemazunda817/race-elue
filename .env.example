# Adresse publique du site (balises canoniques, aperçus de partage, sitemap). Type « Configuration » sur Vercel.
SITE_URL=https://race-elue-disanka.vercel.app
# Service d'inscription e-mail (Brevo, MailerLite, Formspree…). Vide = téléchargement direct de l'ebook.
PUBLIC_NEWSLETTER_ENDPOINT=
# Service de réception des messages de contact. Vide = message préparé dans WhatsApp.
PUBLIC_CONTACT_ENDPOINT=
